<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#801A237E"
                android:endColor="#803949AB"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/rom_flag_blue_light" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/rom_flag_blue_dark"
                android:endColor="#1E88E5"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
