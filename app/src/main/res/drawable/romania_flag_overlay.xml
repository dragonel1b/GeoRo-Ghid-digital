<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Romania Flag Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="@color/romania_blue"
                android:centerColor="@color/romania_yellow"
                android:endColor="@color/romania_red" />
        </shape>
    </item>
    
    <!-- Flag Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="#80000000" />
        </shape>
    </item>
    
    <!-- Waving Effect (subtle gradient overlay) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#10FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>
    
</layer-list> 