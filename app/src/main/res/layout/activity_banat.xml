<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header with back button -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@color/banat_secondary"
            android:elevation="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                android:onClick="goBack"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/regionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Banat"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAppearance="@style/TextAppearance.AppCompat.Title"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToCities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orașe"
                android:layout_marginEnd="8dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                app:cornerRadius="20dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/banat_primary_light"
                app:backgroundTint="@color/banat_primary"
                android:textColor="@color/white"
                app:rippleColor="@color/banat_primary_light"/>

            <TextView
                android:id="@+id/pointsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Puncte"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:drawableStart="@drawable/ic_money"
                android:drawablePadding="4dp"
                android:drawableTint="@color/banat_accent"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"/>
        </LinearLayout>

        <!-- Image Carousel -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/imageCarousel"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/imageIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/imageCarousel"
            app:tabBackground="@drawable/tab_selector"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabTextColor="@color/white"
            app:tabSelectedTextColor="@color/banat_primary_light"
            android:background="@color/banat_primary"/>

        <!-- Content Sections -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/imageIndicator"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Introduction Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/banat_card_background">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bine ai venit în Banat"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/banat_primary"/>
                            
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Descoperă regiunea cu o bogată diversitate culturală, peisaje naturale impresionante și o tradițională ospitalitate bănățeană. O zonă unde influențele multiple au creat un patrimoniu cultural unic."
                            android:textColor="@color/banat_text"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/cityContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Conținutul va fi adăugat dinamic prin cod -->
                </LinearLayout>

                <!-- Navigation Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGoToMap"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Harta Banatului"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="16dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/ic_map"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:backgroundTint="@color/banat_primary"
                    app:rippleColor="@color/banat_primary_light"
                    android:elevation="8dp"
                    android:textColor="@color/white"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGoToCasinoStory"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Timișoara Adventure"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="16dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    app:cornerRadius="32dp"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconSize="24dp"
                    app:icon="@drawable/ic_story"
                    app:iconTint="@color/white"
                    app:backgroundTint="@color/banat_border"
                    app:rippleColor="@color/banat_accent"
                    android:elevation="8dp"
                    android:textColor="@color/white"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGoToDobrogeaGame"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Banat Quiz"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/ic_game"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/white"
                    app:backgroundTint="@color/banat_accent"
                    app:rippleColor="@color/banat_border"
                    android:elevation="8dp"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
