<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".banatusage.BanatStoryActivity">

    <!-- Header with design for Banat theme -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="6dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/banat_primary"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/headerBackButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                android:tint="@color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Povestea Banatului"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginStart="12dp"/>

            <TextView
                android:id="@+id/pointsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:background="@drawable/rounded_points_background"
                android:textColor="@color/white"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/soundToggleButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_sound_on"
                android:contentDescription="Toggle Sound"
                android:tint="@color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Progress Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        app:trackThickness="4dp"
        app:trackColor="@color/banat_primary_light"
        app:indicatorColor="@color/banat_accent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <!-- Main content with ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/progressIndicator"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Story Title -->
            <TextView
                android:id="@+id/storyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Titlu Poveste"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/banat_primary"
                android:letterSpacing="0.01"
                android:shadowColor="#40000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Story Image -->
            <ImageView
                android:id="@+id/storyImageView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:background="@color/banat_primary_light"
                app:layout_constraintTop_toBottomOf="@id/storyTitle"
                tools:src="@drawable/banat_default"/>

            <!-- Story Text -->
            <TextView
                android:id="@+id/storyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Conținutul poveștii va apărea aici."
                android:textSize="17sp"
                android:textColor="@color/banat_text"
                android:lineSpacingExtra="6dp"
                android:letterSpacing="0.02"
                app:layout_constraintTop_toBottomOf="@id/storyImageView"/>

            <!-- Story Context -->
            <TextView
                android:id="@+id/storyContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Context adițional"
                android:textSize="16sp"
                android:textStyle="italic"
                android:textColor="#5C4018"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/storyText"/>

            <!-- Feedback Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/feedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/banat_card_background"
                app:strokeColor="@color/banat_border"
                app:strokeWidth="1dp"
                app:cardElevation="4dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/storyContext">

                <TextView
                    android:id="@+id/feedbackText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="@color/banat_text"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Betting Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bettingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/banat_card_background"
                app:strokeColor="@color/banat_border"
                app:strokeWidth="1dp"
                app:cardElevation="4dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/feedbackCard">

                <!-- Betting content here -->
            </com.google.android.material.card.MaterialCardView>

            <!-- Interactive Test Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/interactiveCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/banat_card_background"
                app:strokeColor="@color/banat_border"
                app:strokeWidth="1dp"
                app:cardElevation="4dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/bettingCard">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:id="@+id/vampireTestTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Test interactiv"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/banat_primary"/>
                        
                    <TextView
                        android:id="@+id/vampireTestDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Descriere test"
                        android:textSize="16sp"
                        android:textColor="@color/banat_text"/>
                        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">
                        
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/objectCard1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/banat_border"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/white">
                            
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">
                                
                                <ImageView
                                    android:id="@+id/objectItemImage1"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/lamp_icon"/>
                                    
                                <TextView
                                    android:id="@+id/objectItemText1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Opțiunea 1"
                                    android:textSize="14sp"
                                    android:textColor="@color/banat_text"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/objectCard2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/banat_border"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/white">
                            
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">
                                
                                <ImageView
                                    android:id="@+id/objectItemImage2"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/map_icon"/>
                                    
                                <TextView
                                    android:id="@+id/objectItemText2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Opțiunea 2"
                                    android:textSize="14sp"
                                    android:textColor="@color/banat_text"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/objectCard3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="2dp"
                            app:strokeColor="@color/banat_border"
                            app:strokeWidth="1dp"
                            app:cardBackgroundColor="@color/white">
                            
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="8dp">
                                
                                <ImageView
                                    android:id="@+id/objectItemImage3"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:src="@drawable/amulet_icon"/>
                                    
                                <TextView
                                    android:id="@+id/objectItemText3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Opțiunea 3"
                                    android:textSize="14sp"
                                    android:textColor="@color/banat_text"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Button Container -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Story Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/storyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Citește povestea"
                android:textColor="@color/white"
                app:icon="@drawable/ic_volume_up"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/banat_secondary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exitButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ieșire"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/banat_border"/>
        </LinearLayout>

        <!-- Choice Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/redButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Opțiunea 1"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/banat_primary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/blackButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Opțiunea 2"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                android:backgroundTint="@color/banat_primary_light"/>
        </LinearLayout>

        <!-- Continue Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Continuă"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/banat_accent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Finalizează"
            android:textColor="@color/white"
            android:visibility="gone"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/banat_accent"/>
    </LinearLayout>

    <!-- Animation Overlay -->
    <ImageView
        android:id="@+id/batAnimation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_bat"
        android:visibility="gone"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout> 