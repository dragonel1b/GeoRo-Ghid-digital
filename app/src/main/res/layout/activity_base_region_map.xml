<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootLayout">

    <!-- MapView ocupă tot ecranul ca fundal -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Header semi-transparent cu titlu și buton de înapoi -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#80000000"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@android:color/white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/regionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Harta Regiunii"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                app:layout_constraintStart_toEndOf="@id/backButton"
                app:layout_constraintEnd_toStartOf="@id/progressText"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progres: 0/0"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Search Bar semi-transparent -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#80FFFFFF"
        app:cardCornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="Caută locații..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="16sp"
                android:textColorHint="#80000000"
                android:imeOptions="actionSearch"
                android:inputType="text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/searchFilterButton"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageButton
                android:id="@+id/searchFilterButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#80000000"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Toolbar cu butoane în colțul din dreapta -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/toolbarCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#80FFFFFF"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        android:layout_marginTop="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/layerToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:fabSize="mini"
                app:tint="@android:color/white"
                android:src="@android:drawable/ic_menu_mapmode"
                app:backgroundTint="@color/rom_primary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/toggle3dButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:fabSize="mini"
                app:tint="@android:color/white"
                android:src="@android:drawable/ic_menu_compass"
                app:backgroundTint="@color/rom_primary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/recenterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                app:fabSize="mini"
                app:tint="@android:color/white"
                android:src="@android:drawable/ic_menu_mylocation"
                app:backgroundTint="@color/rom_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scalebar semi-transparent -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/scalebarCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#80FFFFFF"
        app:cardCornerRadius="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/scalebarLine"
                    android:layout_width="100dp"
                    android:layout_height="2dp"
                    android:background="#000000" />

                <TextView
                    android:id="@+id/scalebarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="100 m"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/distanceTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Distanță: -- | Timp: --"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Card de jos semi-transparent cu butoane și legendă -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#80FFFFFF"
        app:cardCornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Butoane pentru poveste și joc -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/storyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Poveste"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/gameButton"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.48" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gameButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Joc"
                android:textStyle="bold"
                app:cornerRadius="24dp"
                android:layout_marginStart="6dp"
                app:layout_constraintStart_toEndOf="@id/storyButton"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.48" />

            <!-- Carousel orizontal pentru legendă -->
            <HorizontalScrollView
                android:id="@+id/legendScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/storyButton">

                <LinearLayout
                    android:id="@+id/legendContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/legendChipCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="Orașe"
                        app:chipBackgroundColor="#FFFF0000"
                        app:chipIconTint="#FFFFFF"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/legendChipNature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="Natură"
                        app:chipBackgroundColor="#FF00FF00"
                        app:chipIconTint="#FFFFFF"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/legendChipCulture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="Cultură"
                        app:chipBackgroundColor="#FF0000FF"
                        app:chipIconTint="#FFFFFF"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/legendChipHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="Istorie"
                        app:chipBackgroundColor="#FFFFA500"
                        app:chipIconTint="#FFFFFF"
                        android:textColor="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/legendChipVisited"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vizitate"
                        app:chipBackgroundColor="#FF00FFFF"
                        app:chipIconTint="#FFFFFF"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Text cu instrucțiuni -->
            <TextView
                android:id="@+id/instructionsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apasă lung pentru a adăuga un punct de traseu"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/legendScrollView" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Popup pentru selectarea layerului hărții (inițial invizibil) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layerSelectionCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/toolbarCard"
        app:layout_constraintTop_toTopOf="@id/toolbarCard">

        <RadioGroup
            android:id="@+id/layerRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/radioStandard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioSatellite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Satelit" />

            <RadioButton
                android:id="@+id/radioTerrain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Relief" />
        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- Popup pentru filtre de căutare (inițial invizibil) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchFilterCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filtrează după:"
                android:textStyle="bold"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                
                    <CheckBox
                        android:id="@+id/filterVisited"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Locații vizitate" />
    
                    <CheckBox
                        android:id="@+id/filterNotVisited"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Locații nevizitate" />
    
                    <CheckBox
                        android:id="@+id/filterCities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Orașe" />
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    
                    <CheckBox
                        android:id="@+id/filterNature"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Natură" />
    
                    <CheckBox
                        android:id="@+id/filterCulture"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cultură" />
    
                    <CheckBox
                        android:id="@+id/filterHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Istorie" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/applyFiltersButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aplică"
                app:cornerRadius="24dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout> 