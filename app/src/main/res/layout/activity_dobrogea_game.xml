<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dobrogea_bg_maritime"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        tools:context=".dobrogeausage.DobrogeaGameActivity">

        <!-- Header with Score and Timer - Maritime Theme -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/dobrogea_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/dobrogea_primary_light"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <!-- Score Section with Maritime Icon -->
                <LinearLayout
                    android:id="@+id/scoreLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚓ Scor"
                        android:textColor="@color/dobrogea_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:textColor="@color/dobrogea_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="150" />

                </LinearLayout>

                <!-- Timer Section with Compass Theme -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧭 Timp"
                        android:textColor="@color/dobrogea_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/timerTextView"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/timer_background_dobrogea"
                        android:elevation="4dp"
                        android:gravity="center"
                        android:textColor="@color/dobrogea_text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="30" />

                </LinearLayout>

                <!-- Streak Section with Wave Icon -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌊 Serie"
                        android:textColor="@color/dobrogea_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/streakTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dobrogea_primary"
                        android:textSize="18sp"
            android:textStyle="bold"
                        tools:text="3" />

                </LinearLayout>

    </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Lifelines Section - Maritime Tools -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lifelinesCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/dobrogea_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerCard"
            app:strokeColor="@color/dobrogea_primary_light"
            app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/lifelinesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛠️ Unelte maritime: "
                    android:textColor="@color/dobrogea_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <!-- 50/50 Lifeline - Lighthouse -->
                <com.google.android.material.card.MaterialCardView
            android:id="@+id/fiftyFiftyButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Farul - 50/50"
                    app:cardBackgroundColor="@color/dobrogea_card_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:rippleColor="@color/dobrogea_primary_light"
                    app:strokeColor="@color/dobrogea_primary_light"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lighthouse"
                        android:contentDescription="Farul - 50/50"
                        app:tint="@color/dobrogea_text" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Hint Lifeline - Compass -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/hintButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Busola - Indiciu"
                    app:cardBackgroundColor="@color/dobrogea_card_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/dobrogea_primary_light"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_compass"
                        android:contentDescription="Busola - Indiciu"
                        app:tint="@color/dobrogea_text" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Skip Lifeline - Anchor -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/skipQuestionButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ancora - Sari întrebarea"
                    app:cardBackgroundColor="@color/dobrogea_card_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/dobrogea_primary_light"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_anchor"
                        android:contentDescription="Ancora - Sari întrebarea"
                        app:tint="@color/dobrogea_text" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Quit Button - Port -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quitButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Port - Ieșire"
                    app:cardBackgroundColor="@color/dobrogea_card_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/dobrogea_primary_light"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_port"
                        android:contentDescription="Port - Ieșire"
                        app:tint="@color/dobrogea_text" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Bar with Wave Design -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:progressDrawable="@drawable/progress_bar_dobrogea"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lifelinesCard"
            tools:progress="45" />

        <!-- Question Image -->
        <ImageView
            android:id="@+id/questionImage"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"
            tools:src="@drawable/dobrogea_sample"
            tools:visibility="visible" />

        <!-- Question Card with Maritime Theme -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/questionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/dobrogea_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/questionImage"
            app:strokeColor="@color/dobrogea_primary_light"
            app:strokeWidth="2dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌊 Întrebare despre Dobrogea"
                    android:textColor="@color/dobrogea_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/questionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dobrogea_text"
                    android:textSize="18sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="8dp"
                    tools:text="Care este cel mai important port al României situat pe litoralul Mării Negre?" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Answer Cards with Maritime Design -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/answerCard1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/dobrogea_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/questionCard"
            app:strokeColor="@color/dobrogea_primary_light"
            app:strokeWidth="1dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/answerButton1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:textAlignment="textStart"
                android:textColor="@color/dobrogea_text"
                android:textSize="16sp"
                tools:text="A) Constanța" />

    </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/answerCard2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/dobrogea_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/answerCard1"
            app:strokeColor="@color/dobrogea_primary_light"
            app:strokeWidth="1dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:textAlignment="textStart"
                android:textColor="@color/dobrogea_text"
                android:textSize="16sp"
                tools:text="B) Mangalia" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/answerCard3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/dobrogea_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/answerCard2"
            app:strokeColor="@color/dobrogea_primary_light"
            app:strokeWidth="1dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:textAlignment="textStart"
                android:textColor="@color/dobrogea_text"
                android:textSize="16sp"
                tools:text="C) Tulcea" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/answerCard4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/dobrogea_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/answerCard3"
            app:strokeColor="@color/dobrogea_primary_light"
            app:strokeWidth="1dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:padding="16dp"
                android:textAlignment="textStart"
                android:textColor="@color/dobrogea_text"
                android:textSize="16sp"
                tools:text="D) Eforie" />

        </com.google.android.material.card.MaterialCardView>

    <!-- Finish Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishButton"
            android:layout_width="0dp"
        android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/dobrogea_primary"
            android:padding="16dp"
            android:text="🏁 Termină Quiz-ul"
            android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/answerCard4"
            tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout> 

</ScrollView> 