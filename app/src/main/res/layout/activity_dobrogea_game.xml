<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dobrogea_bg_simple">

    <!-- Header with Timer and Score -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/dobrogea_card_bg"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:tint="@color/dobrogea_text"
            android:onClick="goBack"/>

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/timer_background">

            <TextView
                android:id="@+id/timerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="30"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/dobrogea_card_bg"/>
        </FrameLayout>

        <TextView
            android:id="@+id/gameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Quiz Dobrogea"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dobrogea_text"/>

        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scor: 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dobrogea_accent"/>
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:progressTint="@color/dobrogea_primary"
        android:progressBackgroundTint="@color/dobrogea_secondary"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <!-- Lifelines -->
    <LinearLayout
        android:id="@+id/lifelinesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <ImageButton
            android:id="@+id/fiftyFiftyButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:src="@drawable/ic_5050"
            android:background="@drawable/button_ripple"
            android:contentDescription="50:50"/>

        <ImageButton
            android:id="@+id/skipQuestionButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:src="@drawable/ic_skip"
            android:background="@drawable/button_ripple"
            android:contentDescription="Skip Question"/>
    </LinearLayout>

    <!-- Question Card with Image -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/questionCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        app:cardCornerRadius="80dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/dobrogea_card_bg"
        app:layout_constraintTop_toBottomOf="@id/lifelinesLayout"
        app:layout_constraintBottom_toTopOf="@id/answersContainer"
        app:layout_constraintVertical_weight="0.8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dobrogea_card_bg"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/questionImage"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:contentDescription="Question Image"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/questionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:padding="8dp"
                android:textColor="@color/dobrogea_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/factTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_gradient_background"
                android:padding="8dp"
                android:textColor="@color/dobrogea_card_bg"
                android:textSize="14sp"
                android:visibility="gone" />
 
            <TextView
                android:id="@+id/streakTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_gravity="end"
                android:background="@drawable/card_gradient_background"
                android:elevation="4dp"
                android:padding="6dp"
                android:text="🔥 Streak: 0"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Answer Buttons -->
    <LinearLayout
        android:id="@+id/answersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/finishButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textSize="14sp"
            android:padding="8dp"
            android:minHeight="48dp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            android:backgroundTint="@color/dobrogea_primary"
            android:textColor="@color/dobrogea_card_bg"
            android:stateListAnimator="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textSize="14sp"
            android:padding="8dp"
            android:minHeight="48dp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            android:backgroundTint="@color/dobrogea_primary"
            android:textColor="@color/dobrogea_card_bg"
            android:stateListAnimator="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:textSize="14sp"
            android:padding="8dp"
            android:minHeight="48dp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            android:backgroundTint="@color/dobrogea_primary"
            android:textColor="@color/dobrogea_card_bg"
            android:stateListAnimator="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:padding="8dp"
            android:minHeight="48dp"
            android:textStyle="bold"
            app:cornerRadius="6dp"
            android:backgroundTint="@color/dobrogea_primary"
            android:textColor="@color/dobrogea_card_bg"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- Finish Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="4dp"
        android:text="Termină jocul"
        android:textSize="16sp"
        android:minHeight="48dp"
        android:padding="8dp"
        android:textStyle="bold"
        app:cornerRadius="6dp"
        android:backgroundTint="@color/dobrogea_accent"
        android:textColor="@color/dobrogea_card_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout> 