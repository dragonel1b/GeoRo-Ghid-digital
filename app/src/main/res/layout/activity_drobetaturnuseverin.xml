<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/card_background"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drobeta-Turnu Severin"
            android:textColor="#000000"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Attractions ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/buttonBack"
        app:layout_constraintTop_toBottomOf="@id/headerCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Podul lui Traian -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardPod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@color/card_background"
                android:elevation="4dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/titlePod"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Podul lui Traian"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/checkPod"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/checkPod"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descPod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Este cel mai renumit obiectiv istoric al orașului și un simbol al orașului. Podul a fost construit de împăratul roman Traian în jurul anului 105 d.Hr. și a fost folosit pentru a traversa Dunărea, conectând teritoriile imperiului roman. Ruinele podului sunt un loc de vizitat pentru iubitorii de istorie și arheologie."
                    android:textColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/titlePod" />

                <ImageView
                    android:id="@+id/imagePod"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#20000000"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toBottomOf="@id/descPod" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/opinionLayoutPod"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="Ce părere ai despre acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/imagePod">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/notePod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="De ce ai recomanda acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/opinionLayoutPod">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recommendationPod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Muzeul Regiunii Porților de Fier -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardMuzeu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@color/card_background"
                android:elevation="4dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/titleMuzeu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Muzeul Regiunii Porților de Fier"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/checkMuzeu"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/checkMuzeu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descMuzeu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Acest muzeu este dedicat istoriei regiunii și oferă expoziții despre perioada romană, dar și despre tradițiile și cultura locală. Aici vei găsi artefacte istorice, unele dintre ele legate de civilizația romană și de construcția podului lui Traian."
                    android:textColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/titleMuzeu" />

                <ImageView
                    android:id="@+id/imageMuzeu"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#20000000"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toBottomOf="@id/descMuzeu" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/opinionLayoutMuzeu"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="Ce părere ai despre acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/imageMuzeu">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/noteMuzeu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="De ce ai recomanda acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/opinionLayoutMuzeu">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recommendationMuzeu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Castelul de Apă -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCastel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@color/card_background"
                android:elevation="4dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/titleCastel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Castelul de Apă"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/checkCastel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/checkCastel"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descCastel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Un monument simbolic al orașului, Castelul de Apă este un turn de apă construit la începutul secolului XX. A devenit un simbol al orașului datorită arhitecturii sale impresionante și a fost folosit pentru a aproviziona cu apă orașul. Astăzi, este un loc de vizitat pentru turiștii care vor să înțeleagă mai bine istoria urbană a Drobetei."
                    android:textColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/titleCastel" />

                <ImageView
                    android:id="@+id/imageCastel"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#20000000"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toBottomOf="@id/descCastel" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/opinionLayoutCastel"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="Ce părere ai despre acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/imageCastel">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/noteCastel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="De ce ai recomanda acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/opinionLayoutCastel">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recommendationCastel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Parcul Natural Porțile de Fier -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardParc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@color/card_background"
                android:elevation="4dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/titleParc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Parcul Natural Porțile de Fier"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/checkParc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/checkParc"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descParc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Situat în apropierea orașului, acest parc natural este o destinație excelentă pentru iubitorii de natură. Zona oferă peisaje impresionante ale Dunării și ale munților din jur, fiind un loc perfect pentru drumeții și tururi de observare a faunei și florei locale."
                    android:textColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/titleParc" />

                <ImageView
                    android:id="@+id/imageParc"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#20000000"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toBottomOf="@id/descParc" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/opinionLayoutParc"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="Ce părere ai despre acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/imageParc">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/noteParc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="De ce ai recomanda acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/opinionLayoutParc">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recommendationParc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Cetatea Drobeta -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardCetate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@color/card_background"
                android:elevation="4dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/titleCetate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Cetatea Drobeta"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/checkCetate"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/checkCetate"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descCetate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="În apropierea orașului, există ruinele unei cetăți romane care datează din perioada Imperiului Roman, adăugând un alt strat de interes istoric pentru vizitatori."
                    android:textColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/titleCetate" />

                <ImageView
                    android:id="@+id/imageCetate"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#20000000"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toBottomOf="@id/descCetate" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/opinionLayoutCetate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="Ce părere ai despre acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/imageCetate">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/noteCetate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@color/white"
                    android:elevation="2dp"
                    android:hint="De ce ai recomanda acest loc?"
                    android:padding="8dp"
                    android:textColorHint="#000000"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="#000000"
                    app:hintTextColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/opinionLayoutCetate">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recommendationCetate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:padding="12dp"
                        android:textColor="#000000"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Back Button -->
    <Button
        android:id="@+id/buttonBack"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#002B7F"
        android:onClick="goBack"
        android:text="Înapoi"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
