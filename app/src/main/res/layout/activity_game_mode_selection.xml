<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:id="@+id/gameSelectionContainer"
    tools:context=".munteniausage.GameModeSelectionActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/muntenia_primary"
            app:titleTextColor="@color/white"
            app:title="Selectează Modul de Joc - Muntenia" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Player Stats Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/playerStatsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📊 Statistici Jucător"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text_color"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/statsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎮 Jocuri jucate: 0\n📊 Întrebări răspunse: 0\n✅ Acuratețe: 0%\n🔥 Streak curent: 0 zile\n⏱️ Timp total: 0 minute"
                        android:textSize="14sp"
                        android:textColor="@color/secondary_text_color"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/playerStatsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Statistici jucător..."
                        android:textSize="14sp"
                        android:textColor="@color/secondary_text_color"
                        android:lineSpacingExtra="2dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/recommendationsTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Recomandări..."
                        android:textSize="14sp"
                        android:textColor="@color/secondary_text_color"
                        android:lineSpacingExtra="2dp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Data Source Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📚 Sursa Întrebărilor"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text_color"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dataSourceButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔍 Selectează sursa întrebărilor"
                        android:textSize="14sp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:icon="@android:drawable/ic_menu_preferences"
                        app:iconGravity="textStart"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/dataSourceDescriptionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alegeți sursa pentru încărcarea întrebărilor: baza de date online sau cache local."
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text_color" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Game Modes -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎮 Moduri de Joc"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text_color"
                        android:layout_marginBottom="12dp" />

                    <!-- Game Mode Spinner -->
                    <Spinner
                        android:id="@+id/gameModeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/modeDescriptionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descriere mod de joc..."
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text_color"
                        android:layout_marginBottom="12dp" />

                    <!-- Difficulty Spinner -->
                    <Spinner
                        android:id="@+id/difficultySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/difficultyDescriptionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descriere dificultate..."
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text_color"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/gameModeRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerViewGameModes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startGameButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="🚀 Începe Quiz Clasic"
            android:textSize="16sp"
            style="@style/Widget.Material3.Button"
            app:backgroundTint="@color/muntenia_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⬅️ Înapoi"
            android:textSize="16sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:strokeColor="@color/muntenia_primary" />

    </LinearLayout>

</LinearLayout> 