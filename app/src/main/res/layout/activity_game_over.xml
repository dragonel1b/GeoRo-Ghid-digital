<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/transilvania_bg_simple"
    android:padding="16dp"
    tools:context=".transilvaniausage.GameOverActivity">

    <TextView
        android:id="@+id/gameOverTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Aventură Terminată!"
        android:textColor="@color/transilvania_text"
        android:textSize="32sp"
        android:textStyle="bold"
        android:shadowColor="@color/transilvania_secondary"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/scoreLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Scorul Tău:"
        android:textColor="@color/transilvania_text"
        android:textSize="24sp"
        android:shadowColor="@color/transilvania_secondary"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gameOverTitle" />

    <TextView
        android:id="@+id/scoreTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/transilvania_accent"
        android:textSize="48sp"
        android:textStyle="bold"
        android:shadowColor="@color/transilvania_secondary"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scoreLabel"
        tools:text="150" />

    <androidx.cardview.widget.CardView
        android:id="@+id/statsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scoreTextView">

        <TextView
            android:id="@+id/statsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textSize="18sp"
            android:textColor="@color/transilvania_text"
            tools:text="8 din 10 răspunsuri corecte (80%)" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/achievementsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/transilvania_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statsCard">

        <TextView
            android:id="@+id/achievementsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="@color/transilvania_text"
            tools:text="Realizări:
• Expert al Transilvaniei (8 din 10 corecte)
• Cunoscător al Transilvaniei (serie de 3 răspunsuri corecte)" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playAgainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/transilvania_primary"
            android:text="Joacă din nou"
            android:textColor="@color/transilvania_text"
            android:padding="16dp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/transilvania_primary_light"
            app:strokeWidth="2dp"
            app:icon="@drawable/ic_game"
            app:iconTint="@color/transilvania_text"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/transilvania_secondary"
            android:text="Distribuie rezultatul"
            android:textColor="@color/transilvania_text"
            android:padding="16dp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/transilvania_accent"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_share"
            app:iconTint="@color/transilvania_text"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backToMapButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/transilvania_primary_light"
            android:text="Înapoi la Transilvania"
            android:textColor="@color/transilvania_text"
            android:padding="16dp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/transilvania_accent"
            app:strokeWidth="1dp"
            app:icon="@drawable/ic_map"
            app:iconTint="@color/transilvania_text"
            app:iconGravity="textStart" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 