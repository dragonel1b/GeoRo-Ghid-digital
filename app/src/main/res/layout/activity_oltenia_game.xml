<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oltenia_bg_simple">

    <!-- Header with Timer and Score -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@color/oltenia_primary"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:tint="@color/oltenia_card_bg"
            android:onClick="goBack"/>

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/timer_background_oltenia">

            <TextView
                android:id="@+id/timerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="30"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/oltenia_card_bg"/>
        </FrameLayout>

        <TextView
            android:id="@+id/gameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Aventura Olteniei"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/oltenia_card_bg"/>

        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scor: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/oltenia_accent"/>
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressTint="@color/oltenia_accent"
        android:progressBackgroundTint="@color/oltenia_secondary"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <!-- Lifelines -->
    <LinearLayout
        android:id="@+id/lifelinesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/oltenia_secondary"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <ImageButton
            android:id="@+id/fiftyFiftyButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:src="@drawable/ic_5050"
            android:tint="@color/oltenia_card_bg"
            android:background="@drawable/timer_background_oltenia"
            android:contentDescription="50:50"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Deblochează comoara Olteniei"
            android:textColor="@color/oltenia_card_bg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <ImageButton
            android:id="@+id/skipQuestionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:src="@drawable/ic_skip"
            android:tint="@color/oltenia_card_bg"
            android:background="@drawable/timer_background_oltenia"
            android:contentDescription="Skip Question"/>
    </LinearLayout>

    <!-- Question Card with Image -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/questionCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/oltenia_accent"
        app:cardBackgroundColor="@color/oltenia_card_bg"
        app:layout_constraintTop_toBottomOf="@id/lifelinesLayout"
        app:layout_constraintBottom_toTopOf="@id/answersContainer"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/questionImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:contentDescription="Question Image"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/questionTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="@color/oltenia_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/factTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_gradient_background_oltenia"
                android:padding="12dp"
                android:textColor="@color/oltenia_card_bg"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/streakTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_gravity="center"
                android:background="@drawable/timer_background_oltenia"
                android:elevation="4dp"
                android:padding="8dp"
                android:text="🔥 Reușite consecutive: 0"
                android:textColor="@color/oltenia_card_bg"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Answer Buttons -->
    <LinearLayout
        android:id="@+id/answersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/finishButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="16sp"
            android:padding="12dp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/oltenia_primary"
            android:textColor="@color/oltenia_card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/oltenia_accent"
            android:stateListAnimator="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="16sp"
            android:padding="12dp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/oltenia_primary"
            android:textColor="@color/oltenia_card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/oltenia_accent"
            android:stateListAnimator="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="16sp"
            android:padding="12dp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/oltenia_primary"
            android:textColor="@color/oltenia_card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/oltenia_accent"
            android:stateListAnimator="@null"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:padding="12dp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:backgroundTint="@color/oltenia_primary"
            android:textColor="@color/oltenia_card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/oltenia_accent"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- Finish Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:text="Finalizare Călătorie"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="12dp"
        app:cornerRadius="24dp"
        android:backgroundTint="@color/oltenia_accent"
        android:textColor="@color/oltenia_primary"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        app:iconTint="@color/oltenia_primary"
        app:iconSize="24dp"
        app:iconPadding="8dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout> 