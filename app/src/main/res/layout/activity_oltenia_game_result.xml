<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oltenia_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏛️ Rezultate Quiz Oltenia"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/oltenia_primary"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/oltenia_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Score Section -->
                <TextView
                    android:id="@+id/scoreTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 0 puncte"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/oltenia_primary"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Accuracy Section -->
                <TextView
                    android:id="@+id/accuracyTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 0.0% acuratețe (0/0)"
                    android:textSize="18sp"
                    android:textColor="@color/oltenia_text"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <!-- Streak Section -->
                <TextView
                    android:id="@+id/streakTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔥 Seria maximă: 0"
                    android:textSize="16sp"
                    android:textColor="@color/oltenia_text"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <!-- Time Section -->
                <TextView
                    android:id="@+id/timeTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Timp total: 0:00"
                    android:textSize="16sp"
                    android:textColor="@color/oltenia_text"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/oltenia_divider"
                    android:layout_marginVertical="16dp" />

                <!-- Achievements Section -->
                <TextView
                    android:id="@+id/achievementsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏆 Realizări:\n• Încărcare..."
                    android:textSize="14sp"
                    android:textColor="@color/oltenia_text"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:spacing="12dp">

            <!-- Play Again Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playAgainButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔄 Joacă din nou"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/oltenia_primary"
                android:textColor="@android:color/white"
                android:layout_marginBottom="12dp" />

            <!-- Share Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📤 Distribuie rezultatul"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/oltenia_secondary"
                android:textColor="@android:color/white"
                android:layout_marginBottom="12dp" />

            <!-- Main Menu Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mainMenuButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🏠 Meniul principal"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/oltenia_accent"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- Bottom Spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>

</ScrollView> 