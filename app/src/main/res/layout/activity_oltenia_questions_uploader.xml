<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F5F5">

    <!-- Header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📚 Încărcare Întrebări Oltenia"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:gravity="center"
                android:layout_marginBottom="8dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activitate administrativă pentru încărcarea întrebărilor despre Oltenia în baza de date Firebase"
                android:textSize="14sp"
                android:textColor="#666666"
                android:gravity="center" />
                
        </LinearLayout>
        
    </com.google.android.material.card.MaterialCardView>

    <!-- Informații despre întrebări -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Conținut pentru încărcare:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="12dp" />
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏛️ Istorie - 5 întrebări\n🗺️ Geografie - 5 întrebări\n🎭 Cultură - 5 întrebări\n🏰 Arhitectură - 5 întrebări\n🍽️ Gastronomie - 5 întrebări\n👑 Personalități - 5 întrebări\n🌲 Natură - 5 întrebări\n🐉 Legende - 5 întrebări"
                android:textSize="14sp"
                android:textColor="#666666"
                android:lineSpacingExtra="4dp" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginVertical="12dp" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Total: 40 de întrebări"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1976D2" />
                
        </LinearLayout>
        
    </com.google.android.material.card.MaterialCardView>

    <!-- Status și Progress -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">
            
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="#1976D2"
                android:visibility="gone" />
            
            <TextView
                android:id="@+id/statusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pregătit pentru încărcarea întrebărilor despre Oltenia"
                android:textSize="16sp"
                android:textColor="#333333"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />
                
        </LinearLayout>
        
    </com.google.android.material.card.MaterialCardView>

    <!-- Buton de încărcare -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/uploadButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🚀 Încarcă întrebările în Firebase"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="#1976D2"
        android:textColor="@android:color/white" />
        
    <!-- Avertisment -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFF3E0">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ATENȚIE: Această operație va încărca întrebări noi în Firebase. Asigură-te că ai permisiunile necesare."
                android:textSize="12sp"
                android:textColor="#E65100" />
                
        </LinearLayout>
        
    </com.google.android.material.card.MaterialCardView>

</LinearLayout> 