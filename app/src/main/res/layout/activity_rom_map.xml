<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Joc1.RomMapActivity">

    <!-- Container pentru hartă (layer de bază) -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Harta României" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="8dp"
            android:layout_margin="12dp"
            app:contentInsetStart="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Înapoi"
                    android:src="@drawable/ic_back" />

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@android:color/white"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@android:color/transparent"
                    app:queryHint="Caută regiuni, orașe..." />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Adăugare filtrare regiuni -->
        <LinearLayout
            android:id="@+id/filterRegionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="80dp"
            android:layout_marginHorizontal="12dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#DDDDDD">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Filtrează regiunile"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginBottom="8dp"/>

                    <HorizontalScrollView
                        android:id="@+id/regionFiltersScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/regionFilterChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            app:singleSelection="true"
                            app:singleLine="true"
                            app:chipSpacingHorizontal="8dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/allRegionsChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Toate regiunile"
                                android:checkable="true"
                                android:checked="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_map"
                                app:chipBackgroundColor="@color/purple_200" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/transylvaniaChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Transilvania"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#4CAF50" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/moldovaChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Moldova"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#2196F3" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/munteniaChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Muntenia"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#FF9800" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/olteniaChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Oltenia"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#9C27B0" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/dobrogeaChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dobrogea"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#FFEB3B" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/banatChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Banat"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#E91E63" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/crisanaChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Crișana"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#00BCD4" />
                                
                            <com.google.android.material.chip.Chip
                                android:id="@+id/maramuresChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Maramureș"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#8BC34A" />
                                
                            <com.google.android.material.chip.Chip
                                android:id="@+id/bucovinaChip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bucovina"
                                android:checkable="true"
                                app:chipIconVisible="true"
                                app:chipIcon="@drawable/ic_location"
                                app:chipBackgroundColor="#795548" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/styleToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="50dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ic_night_mode" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/discoverFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="40dp"
            android:layout_marginBottom="80dp"
            android:text="Descoperă"
            app:icon="@drawable/ic_explore" />

    </FrameLayout>

    <!-- Card pentru informații regiune (Bottom Sheet) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/regionInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        app:behavior_hideable="true"
        app:behavior_peekHeight="120dp"
        app:cardCornerRadius="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/regionNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nume Regiune"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/regionDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Descriere regiune..."
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@android:color/darker_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Misiuni disponibile:"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/missionsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/exploreRegionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Explorează Regiunea" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 