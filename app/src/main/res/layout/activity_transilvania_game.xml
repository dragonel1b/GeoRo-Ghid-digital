<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/transilvania_bg_simple"
    tools:context=".transilvaniausage.TransilvaniaGameActivity">

    <!-- Header area with score, timer and lifelines -->
    <LinearLayout
        android:id="@+id/scoreLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/timer_background_transilvania"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scor: "
            android:textColor="@color/transilvania_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/transilvania_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Serie: "
            android:textColor="@color/transilvania_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/streakTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/transilvania_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="0" />
    </LinearLayout>

    <TextView
        android:id="@+id/timerTextView"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/timer_background_transilvania"
        android:elevation="6dp"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="@color/transilvania_text"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.464"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="30" />

    <LinearLayout
        android:id="@+id/lifelinesLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fiftyFiftyButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/fifty_fifty_desc"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/transilvania_card_bg"
            app:cornerRadius="14dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_fifty_fifty"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/transilvania_text"
            app:rippleColor="@color/transilvania_primary_light"
            app:strokeColor="@color/transilvania_primary_light"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hintButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Indiciu"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/transilvania_card_bg"
            app:cornerRadius="14dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_hint"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/transilvania_text"
            app:strokeColor="@color/transilvania_primary_light"
            app:strokeWidth="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/skipQuestionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Sari peste întrebare"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/transilvania_card_bg"
            app:cornerRadius="14dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_skip"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/transilvania_text"
            app:strokeColor="@color/transilvania_primary_light"
            app:strokeWidth="2dp" />
    </LinearLayout>

    <!-- Question area -->
    <TextView
        android:id="@+id/questionTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/card_gradient_background_transilvania"
        android:gravity="center"
        android:minHeight="70dp"
        android:padding="12dp"
        android:textColor="@color/transilvania_text"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timerTextView"
        tools:text="Întrebare despre Transilvania?" />

    <androidx.cardview.widget.CardView
        android:id="@+id/questionImageCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/questionTextView">

        <ImageView
            android:id="@+id/questionImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:adjustViewBounds="true"
            android:contentDescription="Imagine pentru întrebare"
            android:scaleType="centerCrop"
            android:visibility="visible" />
    </androidx.cardview.widget.CardView>

    <!-- Answer area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/answerCard1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/questionImageCard"
        app:rippleColor="@color/transilvania_primary_light"
        app:strokeColor="@color/transilvania_primary_light"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:stateListAnimator="@null"
            android:textAlignment="textStart"
            android:textColor="@color/transilvania_text"
            android:textSize="14sp"
            app:backgroundTint="@color/transilvania_card_bg"
            app:cornerRadius="14dp"
            app:rippleColor="@color/transilvania_primary_light"
            tools:text="Răspuns 1" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/answerCard2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answerCard1"
        app:rippleColor="@color/transilvania_primary_light"
        app:strokeColor="@color/transilvania_primary_light"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:stateListAnimator="@null"
            android:textAlignment="textStart"
            android:textColor="@color/transilvania_text"
            android:textSize="14sp"
            app:backgroundTint="@color/transilvania_card_bg"
            app:cornerRadius="14dp"
            app:rippleColor="@color/transilvania_primary_light"
            tools:text="Răspuns 2" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/answerCard3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answerCard2"
        app:rippleColor="@color/transilvania_primary_light"
        app:strokeColor="@color/transilvania_primary_light"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:stateListAnimator="@null"
            android:textAlignment="textStart"
            android:textColor="@color/transilvania_text"
            android:textSize="14sp"
            app:backgroundTint="@color/transilvania_card_bg"
            app:cornerRadius="14dp"
            app:rippleColor="@color/transilvania_primary_light"
            tools:text="Răspuns 3" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/answerCard4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answerCard3"
        app:rippleColor="@color/transilvania_primary_light"
        app:strokeColor="@color/transilvania_primary_light"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:stateListAnimator="@null"
            android:textAlignment="textStart"
            android:textColor="@color/transilvania_text"
            android:textSize="14sp"
            app:backgroundTint="@color/transilvania_card_bg"
            app:cornerRadius="14dp"
            app:rippleColor="@color/transilvania_primary_light"
            tools:text="Răspuns 4" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Footer area -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="TERMINARE"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/transilvania_primary"
        app:cornerRadius="16dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/transilvania_text"
        app:strokeWidth="1dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:minHeight="8dp"
        android:progressBackgroundTint="@color/transilvania_secondary"
        android:progressTint="@color/transilvania_primary_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout> 