<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/transilvania_bg_simple"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        tools:context=".transilvaniausage.TransilvaniaGameActivity">

        <!-- Header with Score and Timer in a single row -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/transilvania_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/transilvania_primary_light"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <!-- Score Section -->
                <LinearLayout
                    android:id="@+id/scoreLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:text="Scor"
            android:textColor="@color/transilvania_text"
                        android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scoreTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:textColor="@color/transilvania_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="150" />

                </LinearLayout>

                <!-- Timer Section -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Timp"
                        android:textColor="@color/transilvania_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/timerTextView"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/timer_background_transilvania"
                        android:elevation="4dp"
                        android:gravity="center"
            android:textColor="@color/transilvania_text"
                        android:textSize="20sp"
            android:textStyle="bold"
                        tools:text="30" />

                </LinearLayout>

                <!-- Streak Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:text="Serie"
            android:textColor="@color/transilvania_text"
                        android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/streakTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                        android:textColor="@color/transilvania_primary"
                        android:textSize="18sp"
            android:textStyle="bold"
                        tools:text="3" />

                </LinearLayout>

    </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Lifelines Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lifelinesCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/transilvania_card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/headerCard"
            app:strokeColor="@color/transilvania_primary_light"
            app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/lifelinesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center">

                <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
                    android:text="Ajutoare: "
                    android:textColor="@color/transilvania_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fiftyFiftyButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="50/50"
            app:cardBackgroundColor="@color/transilvania_card_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
            app:rippleColor="@color/transilvania_primary_light"
            app:strokeColor="@color/transilvania_primary_light"
                    app:strokeWidth="1dp">

            <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_fifty_fifty"
                        android:contentDescription="50/50"
                app:tint="@color/transilvania_text" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hintButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Indiciu"
            app:cardBackgroundColor="@color/transilvania_card_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
            app:strokeColor="@color/transilvania_primary_light"
                    app:strokeWidth="1dp">

            <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hint"
                android:contentDescription="Indiciu"
                app:tint="@color/transilvania_text" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/skipQuestionButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sari peste întrebare"
            app:cardBackgroundColor="@color/transilvania_card_bg"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
            app:strokeColor="@color/transilvania_primary_light"
                    app:strokeWidth="1dp">

            <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_skip"
                android:contentDescription="Sari peste întrebare"
                app:tint="@color/transilvania_text" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/quitButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Încheie quiz"
            app:cardBackgroundColor="@color/rom_error"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
            app:rippleColor="@color/rom_error_dark"
            app:strokeColor="@color/rom_error_dark"
                    app:strokeWidth="1dp">

            <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_exit"
                android:contentDescription="Încheie quiz"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:progressBackgroundTint="@color/transilvania_secondary"
            android:progressTint="@color/transilvania_primary_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lifelinesCard" />

        <!-- Question Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/transilvania_card_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"
            app:strokeColor="@color/transilvania_primary_light"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

    <TextView
        android:id="@+id/questionTextView"
                    android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
                    android:minHeight="60dp"
        android:textColor="@color/transilvania_text"
        android:textSize="18sp"
        android:textStyle="bold"
                    android:lineSpacingExtra="4dp"
                    tools:text="Care este cel mai înalt vârf montan din Transilvania?" />

                <!-- Question Image (optional) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/questionImageCard"
                    android:layout_width="match_parent"
        android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

        <ImageView
            android:id="@+id/questionImage"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:adjustViewBounds="true"
            android:contentDescription="Imagine pentru întrebare"
                        android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Answers Section -->
        <LinearLayout
            android:id="@+id/answersContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/questionCard">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/answerCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/transilvania_card_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
        app:rippleColor="@color/transilvania_primary_light"
        app:strokeColor="@color/transilvania_primary_light"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
            android:stateListAnimator="@null"
            android:textAlignment="textStart"
            android:textColor="@color/transilvania_text"
                    android:textSize="16sp"
            app:backgroundTint="@color/transilvania_card_bg"
                    app:cornerRadius="12dp"
            app:rippleColor="@color/transilvania_primary_light"
                    tools:text="A) Vârful Moldoveanu" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/answerCard2"
                android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
                app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:rippleColor="@color/transilvania_primary_light"
        app:strokeColor="@color/transilvania_primary_light"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
            android:stateListAnimator="@null"
            android:textAlignment="textStart"
            android:textColor="@color/transilvania_text"
                    android:textSize="16sp"
            app:backgroundTint="@color/transilvania_card_bg"
                    app:cornerRadius="12dp"
            app:rippleColor="@color/transilvania_primary_light"
                    tools:text="B) Vârful Omu" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/answerCard3"
                android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
                app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:rippleColor="@color/transilvania_primary_light"
        app:strokeColor="@color/transilvania_primary_light"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
            android:stateListAnimator="@null"
            android:textAlignment="textStart"
            android:textColor="@color/transilvania_text"
                    android:textSize="16sp"
            app:backgroundTint="@color/transilvania_card_bg"
                    app:cornerRadius="12dp"
            app:rippleColor="@color/transilvania_primary_light"
                    tools:text="C) Vârful Parâng" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/answerCard4"
                android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/transilvania_card_bg"
                app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:rippleColor="@color/transilvania_primary_light"
        app:strokeColor="@color/transilvania_primary_light"
        app:strokeWidth="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answerButton4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
            android:stateListAnimator="@null"
            android:textAlignment="textStart"
            android:textColor="@color/transilvania_text"
                    android:textSize="16sp"
            app:backgroundTint="@color/transilvania_card_bg"
                    app:cornerRadius="12dp"
            app:rippleColor="@color/transilvania_primary_light"
                    tools:text="D) Vârful Retezat" />
    </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Finish Button (hidden by default) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/finishButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp"
        android:text="TERMINARE"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/transilvania_primary"
        app:cornerRadius="16dp"
        app:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/answersContainer"
        app:strokeColor="@color/transilvania_text"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout> 

</ScrollView> 