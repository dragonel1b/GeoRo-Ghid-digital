<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:elevation="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Bottom Sheet Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bottom_sheet_handle" />

        <!-- Region Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Region Flag/Emblem -->
            <ImageView
                android:id="@+id/regionEmblemImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp"
                android:scaleType="centerCrop"
                tools:src="@drawable/transilvania_emblem" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Region Name -->
                <TextView
                    android:id="@+id/regionNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/medieval_sharp"
                    android:textColor="@color/region_title_color"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Transilvania" />

                <!-- Region Subtitle -->
                <TextView
                    android:id="@+id/regionSubtitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/region_subtitle_color"
                    android:textSize="14sp"
                    tools:text="Țara de dincolo de păduri" />
            </LinearLayout>

            <!-- Close Button -->
            <ImageButton
                android:id="@+id/closeBottomSheetButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:tint="@color/close_button_color" />
        </LinearLayout>

        <!-- Region Description -->
        <TextView
            android:id="@+id/regionDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/roboto_regular"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/region_description_color"
            android:textSize="16sp"
            tools:text="Transilvania este o regiune istorică din centrul României, cunoscută pentru castelele sale medievale, orașele săsești și peisajele montane spectaculoase." />

        <!-- Resources Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/available_resources"
                android:textColor="@color/section_title_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Fuel Resource -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_fuel"
                        android:tint="@color/fuel_color" />

                    <TextView
                        android:id="@+id/regionFuelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="@color/resource_text_color"
                        android:textSize="12sp"
                        tools:text="50L" />
                </LinearLayout>

                <!-- Food Resource -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_food"
                        android:tint="@color/food_color" />

                    <TextView
                        android:id="@+id/regionFoodText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="@color/resource_text_color"
                        android:textSize="12sp"
                        tools:text="15kg" />
                </LinearLayout>

                <!-- Money Resource -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_money"
                        android:tint="@color/money_color" />

                    <TextView
                        android:id="@+id/regionMoneyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="@color/resource_text_color"
                        android:textSize="12sp"
                        tools:text="200 RON" />
                </LinearLayout>

                <!-- Culture Resource -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_culture"
                        android:tint="@color/culture_color" />

                    <TextView
                        android:id="@+id/regionCultureText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto_medium"
                        android:textColor="@color/resource_text_color"
                        android:textSize="12sp"
                        tools:text="75" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quest List Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/available_quests"
                    android:textColor="@color/section_title_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/questCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/quest_count_background"
                    android:fontFamily="@font/roboto_medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/quest_count_text"
                    android:textSize="12sp"
                    tools:text="5" />
            </LinearLayout>

            <!-- Quest RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/questRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_quest" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/navigateToRegionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/navigate_here"
                app:backgroundTint="@color/navigate_button_background"
                app:icon="@drawable/ic_navigation"
                app:iconTint="@color/navigate_button_icon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startQuestButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/start_quest"
                app:backgroundTint="@color/quest_button_background"
                app:icon="@drawable/ic_quest"
                app:iconTint="@color/quest_button_icon" />
        </LinearLayout>

        <!-- Exploration Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/rom_map_exploration_progress"
                android:textColor="@color/section_title_color"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/explorationProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="65"
                    android:progressTint="@color/progress_bar_color" />

                <TextView
                    android:id="@+id/explorationProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/roboto_medium"
                    android:textColor="@color/progress_text_color"
                    android:textSize="14sp"
                    tools:text="65%" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Padding -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
