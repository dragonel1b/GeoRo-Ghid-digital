<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/dialog_background">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Călătoria ta în Crișana s-a încheiat!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/medalImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_medal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/dialogTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/pointsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/medalImage">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Puncte obținute: "
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pointsEarned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150 puncte"
            android:textSize="18sp"
            android:textColor="#4CAF50" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/secretsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/pointsContainer">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secrete descoperite: "
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/secretsFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 din 9"
            android:textSize="18sp"
            android:textColor="#FF9800" />
    </LinearLayout>

    <TextView
        android:id="@+id/specialMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ai descoperit câteva secrete ale Crișanei, dar această regiune are mult mai multe mistere ascunse. Revino pentru a descoperi mai multe!"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/secretsContainer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/specialMessage"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Împărtășește"
            app:icon="@drawable/ic_share"
            android:layout_marginEnd="8dp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Închide"
            android:layout_marginStart="8dp"
            app:cornerRadius="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 