<?xml version="1.0" encoding="utf-8"?>
<!-- item_attraction.xml — "EventCard" style from EventCard.tsx:
     Gradient border (gold->orange->gold), tall image, blur date badge,
     dark bottom gradient, title + subtitle overlay -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="28dp">

    <!-- Gradient border shell (from-cluj-gold via-cluj-accent to-cluj-gold) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_border_attraction"/>

    <!-- Inner dark card inset by 3dp to show gradient border -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:orientation="vertical"
        android:background="@drawable/bg_attraction_inner"
        android:clipToOutline="true">

        <!-- Tall image section (matches h-64 in React) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <!-- Shimmer loading -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/attractionShimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#1A2A1A"/>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <ImageView
                android:id="@+id/imageAttraction"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/city_image_placeholder"/>

            <!-- Blur pill badge — date/location (top-left, matches React) -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/attractionBlurView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp">
                <TextView
                    android:id="@+id/attractionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/pill_blur_dark"
                    android:text="Atracție"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="normal"/>
            </eightbitlab.com.blurview.BlurView>

        </FrameLayout>

        <!-- Bottom section — gradient from dark, title, subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp"
            android:background="@drawable/gradient_card_bottom">

            <TextView
                android:id="@+id/titleAttraction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.1"/>

            <!-- Opinion input field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/opinionAttraction"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="#F97316"
                app:hintTextColor="#F97316"
                app:boxBackgroundColor="#0DFFFFFF"
                android:textColorHint="#6B7280"
                android:hint="Părerea ta">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="2"
                    android:gravity="top|start"
                    android:textColor="#FFFFFF"
                    android:inputType="textMultiLine" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>