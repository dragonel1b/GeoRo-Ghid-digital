<?xml version="1.0" encoding="utf-8"?>
<!-- section_layout.xml — Cluj Spirit "Discover Category Card" style
     Matches the horizontal scroll cards in Dashboard.tsx CATEGORIES section -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:orientation="vertical"
    android:background="@drawable/bg_braided_border"
    android:clipToOutline="true"
    android:padding="0dp">

    <!-- Image header with overlay (matches .h-32 card image in Dashboard) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sectionShimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#1A2A1A"/>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <ImageView
            android:id="@+id/sectionImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/city_image_placeholder"
            android:visibility="visible"/>

        <!-- Dark overlay over image -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"/>

        <!-- Orange icon + title (top-left, matching Dashboard category card) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_container"
                android:gravity="center">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_star"
                    app:tint="#FFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/sectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Visited checkbox top-right -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/visitedCheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            app:buttonTint="#F97316"/>

        <!-- Important dot badge -->
        <View
            android:id="@+id/importantBadge"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="52dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/circle_badge"
            android:backgroundTint="#F97316"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Content body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/sectionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:lineSpacingMultiplier="1.5"/>

    </LinearLayout>

</LinearLayout>
