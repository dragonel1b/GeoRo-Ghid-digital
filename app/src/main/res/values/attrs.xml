<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Temporary declarations to help IDE recognize DotsIndicator attributes -->
    <declare-styleable name="DotsIndicator">
        <attr name="dotsColor" format="color|reference" />
        <attr name="dotsSize" format="dimension|reference" />
        <attr name="dotsSpacing" format="dimension|reference" />
        <attr name="dotsWidthFactor" format="float|reference" />
        <attr name="dotsCornerRadius" format="dimension|reference" />
        <attr name="selectedDotColor" format="color|reference" />
        <attr name="progressMode" format="boolean|reference" />
    </declare-styleable>

    <!-- Region color attributes -->
    <attr name="colorTransilvania" format="color" />
    <attr name="colorMoldova" format="color" />
    <attr name="colorMuntenia" format="color" />
    <attr name="colorDobrogea" format="color" />
    <attr name="colorOltenia" format="color" />
    <attr name="colorBanat" format="color" />
    <attr name="colorCrisana" format="color" />
    <attr name="colorMaramures" format="color" />
    <attr name="colorBucovina" format="color" />
</resources> 