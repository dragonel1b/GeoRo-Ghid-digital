<?xml version="1.0" encoding="utf-8"?>
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">

    <!-- Blue to Yellow transition -->
    <item android:duration="4000">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#002B7F"
                android:centerColor="#1A237E"
                android:endColor="#1565C0"
                android:type="linear" />
        </shape>
    </item>

    <!-- Yellow transition -->
    <item android:duration="4000">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1565C0"
                android:centerColor="#FFA000"
                android:endColor="#FCD116"
                android:type="linear" />
        </shape>
    </item>

    <!-- Red transition -->
    <item android:duration="4000">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FCD116"
                android:centerColor="#D32F2F"
                android:endColor="#CE1126"
                android:type="linear" />
        </shape>
    </item>

    <!-- Back to Blue transition -->
    <item android:duration="4000">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#CE1126"
                android:centerColor="#1A237E"
                android:endColor="#002B7F"
                android:type="linear" />
        </shape>
    </item>
</animation-list>
