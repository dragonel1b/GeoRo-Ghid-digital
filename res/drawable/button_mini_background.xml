<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#5BB403"
                android:endColor="#0A7166"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="#00897B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#43A047"
                android:endColor="#93A827"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
