<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#80CE1126"
                android:endColor="#80D32F2F"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/rom_flag_red" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/rom_flag_red"
                android:endColor="#FB6060"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1.5dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
