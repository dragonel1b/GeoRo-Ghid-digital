<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1a0d0d"/>
            <gradient
                android:angle="45"
                android:startColor="#1a0d0d"
                android:endColor="#0d0612"
                android:type="linear"/>
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/casino_pattern"
            android:tileMode="repeat"
            android:gravity="fill"/>
    </item>
</layer-list>
