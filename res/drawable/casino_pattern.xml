<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1a0d0d"/>
            <gradient
                android:angle="45"
                android:startColor="#1a0d0d"
                android:endColor="#0d0612"
                android:type="linear"/>
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/ic_heart"
            android:tileMode="repeat"
            android:gravity="fill"
            android:alpha="0.15"/>
    </item>
    <item>
        <bitmap
            android:src="@drawable/ic_diamond"
            android:tileMode="repeat"
            android:gravity="fill"
            android:alpha="0.15"/>
    </item>
    <item>
        <bitmap
            android:src="@drawable/ic_club"
            android:tileMode="repeat"
            android:gravity="fill"
            android:alpha="0.15"/>
    </item>
    <item>
        <bitmap
            android:src="@drawable/ic_spade"
            android:tileMode="repeat"
            android:gravity="fill"
            android:alpha="0.15"/>
    </item>
</layer-list>
