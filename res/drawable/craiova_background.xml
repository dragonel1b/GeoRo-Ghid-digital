<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base blue layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#002B7F" />
        </shape>
    </item>

    <!-- Yellow radial gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.7"
                android:centerY="0.3"
                android:startColor="#99FCD116"
                android:endColor="#00FCD116" />
        </shape>
    </item>

    <!-- Red decorative elements -->
    <item>
        <rotate android:fromDegrees="45">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="45"
                    android:startColor="#33CE1126"
                    android:centerColor="#66CE1126"
                    android:endColor="#00CE1126" />
            </shape>
        </rotate>
    </item>

    <!-- Subtle pattern overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="800dp"
                android:centerX="0.5"
                android:centerY="1.0"
                android:startColor="#15FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
