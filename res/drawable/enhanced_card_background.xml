<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40BF1818"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <!-- Card background -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#30FFFFFF"
                android:centerColor="#999D64"
                android:endColor="#DB706D"
                android:type="linear"/>
            <corners android:radius="20dp"/>
            <stroke
                android:width="1.5dp"
                android:color="#000000"/>
        </shape>
    </item>
</layer-list>
