<?xml version="1.0" encoding="utf-8"?>
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">

            <!-- Outer circle -->
            <path
                android:name="outerCircle"
                android:fillColor="#FFFFFF"
                android:strokeColor="#000000"
                android:strokeWidth="1"
                android:pathData="M12,2 A10,10 0 1,1 12,22 A10,10 0 1,1 12,2" />

            <!-- Inner circle -->
            <path
                android:name="innerCircle"
                android:fillColor="#000000"
                android:pathData="M12,7 A5,5 0 1,1 12,17 A5,5 0 1,1 12,7" />

            <!-- Pulse circles -->
            <path
                android:name="pulse1"
                android:strokeColor="#000000"
                android:strokeWidth="0.5"
                android:strokeAlpha="0.3"
                android:fillAlpha="0"
                android:pathData="M12,4 A8,8 0 1,1 12,20 A8,8 0 1,1 12,4" />

            <path
                android:name="pulse2"
                android:strokeColor="#000000"
                android:strokeWidth="0.5"
                android:strokeAlpha="0.15"
                android:fillAlpha="0"
                android:pathData="M12,6 A6,6 0 1,1 12,18 A6,6 0 1,1 12,6" />
        </vector>
    </aapt:attr>

    <target android:name="pulse1">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:duration="1500"
                    android:valueFrom="0.3"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"/>
            </set>
        </aapt:attr>
    </target>

    <target android:name="pulse2">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:propertyName="strokeAlpha"
                    android:duration="1500"
                    android:valueFrom="0.15"
                    android:valueTo="0"
                    android:valueType="floatType"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:startOffset="750"/>
            </set>
        </aapt:attr>
    </target>

</animated-vector>
