<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000"/>
            <corners android:radius="20dp"/>
            <padding
                android:left="1dp"
                android:top="2dp"
                android:right="1dp"
                android:bottom="2dp"/>
        </shape>
    </item>

    <!-- Main background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/design_default_color_primary"
                android:endColor="@color/design_default_color_primary_dark"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- Shine effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#33FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- Inner shadow -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#20FFFFFF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</layer-list>
