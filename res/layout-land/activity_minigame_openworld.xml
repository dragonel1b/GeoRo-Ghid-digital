<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Game View where items will be drawn - Adjusted for landscape mode -->
        <com.example.myapplication.Joc1.MinigameGameView
            android:id="@+id/gameView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/controlsContainer"
            app:layout_constraintWidth_percent="0.7"/>

        <!-- Game info card - Positioned at the top left -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/gameInfoCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_medium"
            style="@style/RomMinigameInfoCard"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_medium">

                <TextView
                    android:id="@+id/levelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/RomMinigameText.Level"
                    android:text="@string/minigame_level"/>

                <TextView
                    android:id="@+id/missionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/RomMinigameText.Info"/>

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/RomMinigameText.Info"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Player controls container - Positioned on the right side in landscape -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/controlsContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#33000000"
            android:padding="@dimen/margin_normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.3">

            <!-- Movement controls centered vertically -->
            <LinearLayout
                android:id="@+id/directionControlsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/interactButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/upButton"
                    style="@style/RomMinigameButton.Direction"
                    android:layout_gravity="center"
                    app:icon="@drawable/ic_back"
                    android:contentDescription="@string/minigame_up"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/leftButton"
                        style="@style/RomMinigameButton.Direction"
                        app:icon="@drawable/ic_back"
                        android:contentDescription="@string/minigame_left"/>

                    <Space
                        android:layout_width="60dp"
                        android:layout_height="60dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rightButton"
                        style="@style/RomMinigameButton.Direction"
                        app:icon="@drawable/ic_back"
                        android:contentDescription="@string/minigame_right"/>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downButton"
                    style="@style/RomMinigameButton.Direction"
                    android:layout_gravity="center"
                    app:icon="@drawable/ic_back"
                    android:contentDescription="@string/minigame_down"/>

            </LinearLayout>

            <!-- Interact button at the bottom -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/interactButton"
                style="@style/RomMinigameButton.Interact"
                app:icon="@drawable/ic_traditional_item"
                android:visibility="gone"
                android:contentDescription="@string/minigame_interact"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="@dimen/margin_normal"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout> 