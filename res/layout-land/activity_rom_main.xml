<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:contentInsetStart="@dimen/margin_normal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drumul Prin România"
                android:textColor="#3A3A3A"
                android:textSize="@dimen/text_size_xlarge"
                android:textStyle="bold" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/romania_map_bg"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/margin_large">

            <!-- Resource Panel - Positioned at the top right in landscape -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resourcePanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_normal"
                android:layout_marginEnd="@dimen/margin_normal"
                app:cardCornerRadius="16dp"
                app:cardElevation="@dimen/card_elevation_normal"
                app:cardBackgroundColor="#F8F8F8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.35"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin_normal"
                    android:weightSum="3">

                    <!-- Fuel -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:src="@drawable/ic_fuel"
                            android:contentDescription="Combustibil"
                            app:tint="#FF5722" />

                        <TextView
                            android:id="@+id/fuelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:text="50L"
                            android:textSize="@dimen/text_size_normal"
                            android:textStyle="bold"
                            android:textColor="#FF5722" />
                    </LinearLayout>

                    <!-- Money -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:src="@drawable/ic_money"
                            android:contentDescription="Bani"
                            app:tint="#4CAF50" />

                        <TextView
                            android:id="@+id/moneyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:text="1000 RON"
                            android:textSize="@dimen/text_size_normal"
                            android:textStyle="bold"
                            android:textColor="#4CAF50" />
                    </LinearLayout>

                    <!-- Food -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size_medium"
                            android:layout_height="@dimen/icon_size_medium"
                            android:src="@drawable/ic_food"
                            android:contentDescription="Mâncare"
                            app:tint="#FFC107" />

                        <TextView
                            android:id="@+id/foodText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:text="5 kg"
                            android:textSize="@dimen/text_size_normal"
                            android:textStyle="bold"
                            android:textColor="#FFC107" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Culture Points Display - Below Resource Panel -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/culturePointsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/margin_normal"
                app:cardCornerRadius="16dp"
                app:cardElevation="@dimen/card_elevation_normal"
                app:cardBackgroundColor="#F8F8F8"
                app:layout_constraintTop_toBottomOf="@id/resourcePanel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.35"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="@dimen/margin_medium">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/ic_check"
                        android:contentDescription="Puncte Culturale"
                        android:layout_marginEnd="@dimen/margin_medium"
                        app:tint="#673AB7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Puncte Culturale: "
                        android:textColor="#555555"
                        android:textSize="@dimen/text_size_normal" />

                    <TextView
                        android:id="@+id/culturePointsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#673AB7"
                        android:textSize="@dimen/text_size_large"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Activities Section Title - On the left side -->
            <TextView
                android:id="@+id/activitiesSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activități"
                android:textColor="#3A3A3A"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/margin_normal"
                android:layout_marginTop="@dimen/margin_normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Main Buttons Container - On the left side -->
            <LinearLayout
                android:id="@+id/mainButtonsContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginStart="@dimen/margin_normal"
                app:layout_constraintTop_toBottomOf="@id/activitiesSectionTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.55">
                
                <!-- Top Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Minigame Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/minigameCard"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_medium"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="@dimen/card_elevation_normal"
                        app:cardBackgroundColor="#3F51B5"
                        android:clickable="true"
                        android:focusable="true"
                        app:rippleColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:onClick="startMinigame"
                            android:padding="@dimen/margin_normal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:src="@drawable/ic_player_character"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/minigame_label"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_medium"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/margin_medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Traditional Game Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/traditionalGameCard"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_medium"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="@dimen/card_elevation_normal"
                        app:cardBackgroundColor="#009688"
                        android:clickable="true"
                        android:focusable="true"
                        app:rippleColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:onClick="openTarataravremostasiActivity"
                            android:padding="@dimen/margin_normal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:src="@drawable/ic_attraction"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Joc Traditional"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_medium"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/margin_medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Middle Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/margin_medium">

                    <!-- Quiz Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/quizCard"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_medium"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="@dimen/card_elevation_normal"
                        app:cardBackgroundColor="#E91E63"
                        android:clickable="true"
                        android:focusable="true"
                        app:rippleColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:onClick="startQuiz"
                            android:padding="@dimen/margin_normal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:src="@drawable/ic_check"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ÎNCEPE QUIZ-UL"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_medium"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/margin_medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Map Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mapCard"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_medium"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="@dimen/card_elevation_normal"
                        app:cardBackgroundColor="#FF9800"
                        android:clickable="true"
                        android:focusable="true"
                        app:rippleColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:onClick="openMapActivity"
                            android:padding="@dimen/margin_normal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:src="@drawable/ic_attraction"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EXPLOREAZĂ HARTA"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_medium"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/margin_medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Bottom Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/margin_medium">

                    <!-- Quest Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/questCard"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_medium"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="@dimen/card_elevation_normal"
                        app:cardBackgroundColor="#673AB7"
                        android:clickable="true"
                        android:focusable="true"
                        app:rippleColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:onClick="startQuestMode"
                            android:padding="@dimen/margin_normal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:src="@drawable/ic_attraction"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QUEST PATRIMONIU"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_medium"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/margin_medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Culinary Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/culinaryCard"
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_medium"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="@dimen/card_elevation_normal"
                        app:cardBackgroundColor="#4CAF50"
                        android:clickable="true"
                        android:focusable="true"
                        app:rippleColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:onClick="startCulinaryMode"
                            android:padding="@dimen/margin_normal">

                            <ImageView
                                android:layout_width="@dimen/icon_size_small"
                                android:layout_height="@dimen/icon_size_small"
                                android:src="@drawable/ic_food"
                                app:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CĂLĂTORIE CULINARĂ"
                                android:textColor="#FFFFFF"
                                android:textSize="@dimen/text_size_medium"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/margin_medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Destinations Section Title - Below all content -->
            <TextView
                android:id="@+id/destinationsSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Destinații populare"
                android:textColor="#3A3A3A"
                android:textSize="@dimen/text_size_large"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/margin_normal"
                android:layout_marginTop="@dimen/margin_normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mainButtonsContainer" />

            <!-- Destinations RecyclerView - More columns in landscape -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/destinationsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_normal"
                android:layout_marginHorizontal="@dimen/margin_normal"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/destinationsSectionTitle" />

            <!-- Floating Action Button for Achievements -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/achievementsFab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_trophy"
                android:contentDescription="Realizări"
                android:layout_margin="@dimen/margin_normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:fabSize="normal"
                app:tint="#FFFFFF"
                app:backgroundTint="#FF9800" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout> 