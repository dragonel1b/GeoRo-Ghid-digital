                    android:textColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/titleCatedralaInaltareaDomnului" />

                <ImageView
                    android:id="@+id/imageCatedralaInaltareaDomnului"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#20000000"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toBottomOf="@id/descCatedralaInaltareaDomnului" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/opinionLayoutCatedralaInaltarea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
