<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Header with back button -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/bucovina_secondary"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:onClick="goBack"
            app:tint="@color/bucovina_text" />

        <TextView
            android:id="@+id/regionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Bucovina"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/bucovina_text"
            android:textAppearance="@style/TextAppearance.AppCompat.Title"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGoToCities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orașe"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:cornerRadius="20dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/bucovina_primary_light"
            app:backgroundTint="@color/bucovina_primary"
            android:textColor="@color/bucovina_text"
            app:rippleColor="@color/bucovina_primary_light"/>

        <TextView
            android:id="@+id/textBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Puncte"
            android:textSize="16sp"
            android:textColor="@color/bucovina_text"
            android:drawableStart="@drawable/ic_money"
            android:drawablePadding="4dp"
            android:drawableTint="@color/bucovina_accent"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"/>
    </LinearLayout>

    <!-- Image Carousel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/imageCarousel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/imageIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/imageCarousel"
        app:tabBackground="@drawable/tab_selector"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabTextColor="@color/bucovina_text"
        app:tabSelectedTextColor="@color/bucovina_primary_light"
        android:background="@color/bucovina_secondary"/>

    <!-- Content Sections -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/imageIndicator"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Introduction Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/bucovina_card_bg">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bine ai venit în Bucovina"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/bucovina_text"/>
                        
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Descoperă frumusețea mănăstirilor pictate, tradițiile autentice și peisajele spectaculoase din nordul României. O regiune cu istorie bogată și ospitalitate legendară."
                        android:textColor="@color/bucovina_text"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/cityContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Conținutul va fi adăugat dinamic prin cod -->
            </LinearLayout>

            <!-- Navigation Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToMap"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Harta Interactivă"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_map"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/bucovina_text"
                app:backgroundTint="@color/bucovina_primary"
                app:rippleColor="@color/bucovina_primary_light"
                android:elevation="8dp"
                android:textColor="@color/bucovina_text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToCasinoStory"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Povestea Bucovinei"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_casino"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/bucovina_text"
                app:backgroundTint="@color/bucovina_secondary"
                app:rippleColor="@color/bucovina_primary_light"
                android:elevation="8dp"
                android:textColor="@color/bucovina_text"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToDobrogeaGame"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Aventură în Bucovina"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_game"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/bucovina_text"
                app:backgroundTint="@color/bucovina_primary_light"
                app:rippleColor="@color/bucovina_secondary"
                android:elevation="8dp"
                android:textColor="@color/bucovina_text"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
