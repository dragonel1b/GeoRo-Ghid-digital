<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/culinary_background"
    tools:context=".Joc1.Culinary.CookingGuideActivity">

    <!-- AppBar with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/culinary_primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/culinary_primary"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
            app:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Recipe Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/recipeHeaderCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/culinary_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/recipeTitleTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Titlu Rețetă"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recipeDescriptionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Descriere rețetă"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:textColor="@color/culinary_text" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/recipeDifficultyTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center_vertical"
                            android:text="Dificultate: Medie"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textColor="@color/culinary_difficulty_medium"
                            app:drawableStartCompat="@android:drawable/btn_star" />

                        <TextView
                            android:id="@+id/recipeTimeTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:drawablePadding="4dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center_vertical"
                            android:text="Timp: 45 min"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textColor="@color/culinary_text"
                            app:drawableStartCompat="@android:drawable/ic_menu_recent_history" />

                    <TextView
                            android:id="@+id/recipeCategoryTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:drawablePadding="4dp"
                            android:fontFamily="sans-serif"
                            android:gravity="center_vertical"
                            android:text="Categorie: Felul principal"
                            android:textAppearance="?attr/textAppearanceBody2"
                            android:textColor="@color/culinary_text"
                            app:drawableStartCompat="@android:drawable/ic_menu_sort_by_size" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/culturalNotesButton"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Note culturale"
                            android:textColor="@color/culinary_secondary"
                            app:icon="@android:drawable/ic_menu_info_details"
                            app:iconTint="@color/culinary_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/substitutionsButton"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Substituiri"
                            android:textColor="@color/culinary_secondary"
                            app:icon="@android:drawable/ic_menu_edit"
                            app:iconTint="@color/culinary_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tipsButton"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sfaturi"
                            android:textColor="@color/culinary_secondary"
                            app:icon="@android:drawable/ic_menu_help"
                            app:iconTint="@color/culinary_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Video Demo Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/videoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/culinary_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Video demonstrativ"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="#000000">

                        <VideoView
                            android:id="@+id/recipeVideoView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />

                        <ImageButton
                            android:id="@+id/replayButton"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:background="@android:drawable/dialog_holo_light_frame"
                            android:contentDescription="Reluare video"
                            android:src="@android:drawable/ic_menu_rotate"
                            android:visibility="gone" />

                        <View
                            android:id="@+id/videoOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#33000000"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Timer Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/timerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/culinary_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Cronometru"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary" />

                    <TextView
                        android:id="@+id/timerTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="00:00:00"
                        android:textAppearance="?attr/textAppearanceHeadline4"
                        android:textColor="@color/culinary_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/startTimerButton"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Start"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/culinary_secondary"
                            app:icon="@android:drawable/ic_media_play"
                            app:iconTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/stopTimerButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Stop"
                            android:textColor="@color/culinary_secondary"
                            app:icon="@android:drawable/ic_media_pause"
                            app:iconTint="@color/culinary_secondary"
                            app:strokeColor="@color/culinary_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ingredients Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ingredientsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/culinary_ingredient">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Ingrediente"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_accent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/ingredientsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Steps Card with Progress -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/stepsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/culinary_step">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Pași de preparare"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/stepProgressTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="Pasul 1 din 10"
                            android:textAppearance="?attr/textAppearanceBody1"
                            android:textColor="@color/culinary_secondary" />

                        <ProgressBar
                            android:id="@+id/stepProgressBar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="10" />
                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/currentStepCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="4dp"
                        app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                                android:id="@+id/currentStepNumberTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="Pasul 1"
                                android:textAppearance="?attr/textAppearanceSubtitle1"
                                android:textColor="@color/culinary_secondary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/currentStepTextView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="sans-serif"
                                android:text="Descrierea pasului curent"
                                android:textAppearance="?attr/textAppearanceBody1"
                                android:textColor="@color/culinary_text" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/readStepButton"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Citește pasul"
                                    android:textColor="@color/culinary_secondary"
                                    app:icon="@android:drawable/ic_btn_speak_now"
                                    app:iconTint="@color/culinary_secondary"
                                    app:strokeColor="@color/culinary_secondary" />

                                <Switch
                                    android:id="@+id/autoReadSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Auto-citire"
                                    android:textColor="@color/culinary_text" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/prevStepButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Anterior"
                            android:textColor="@color/culinary_secondary"
                            app:icon="@android:drawable/ic_media_previous"
                            app:iconTint="@color/culinary_secondary"
                            app:strokeColor="@color/culinary_secondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/nextStepButton"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Următorul"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/culinary_secondary"
                            app:icon="@android:drawable/ic_media_next"
                            app:iconTint="@color/white" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/stepsRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notes Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/culinary_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Notițe personale"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/notesInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary"
                        android:hint="Adaugă notițe personale despre rețetă">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/notesEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textColor="@color/culinary_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveNotesButton"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="Salvează notițele"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/culinary_primary"
                        app:icon="@android:drawable/ic_menu_save"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Share FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/shareRecipeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Partajează rețeta"
        android:src="@android:drawable/ic_menu_share"
        app:backgroundTint="@color/culinary_primary"
        app:tint="@color/white" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
