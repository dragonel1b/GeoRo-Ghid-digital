<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/culinary_background"
    tools:context=".Joc1.Culinary.CulinaryProfileActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/culinary_primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/culinary_primary"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
            app:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:title="Profilul meu culinar" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="always"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true">

            <!-- Avatar Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profileImageView"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="Fotografie de profil"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:civ_border_color="@color/culinary_primary"
                        app:civ_border_width="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uploadPhotoButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Încarcă fotografie"
                        android:textColor="@color/culinary_primary"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconTint="@color/culinary_primary"
                        app:strokeColor="@color/culinary_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Personal Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/personalInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Informații personale"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary" />

            <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/nameInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                        android:hint="Nume complet"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary"
                        app:startIconDrawable="@android:drawable/ic_menu_edit"
                        app:startIconTint="@color/culinary_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nameEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                            android:maxLines="1"
                            android:textColor="@color/culinary_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Email"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary"
                        app:startIconDrawable="@android:drawable/ic_dialog_email"
                        app:startIconTint="@color/culinary_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="@color/culinary_text" />
            </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phoneInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Telefon"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary"
                        app:startIconDrawable="@android:drawable/ic_menu_call"
                        app:startIconTint="@color/culinary_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:textColor="@color/culinary_text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cooking Skills Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cookingSkillsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Abilități culinare"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/skillLevelDropdown"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Nivel de abilitate"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary"
                        app:startIconDrawable="@android:drawable/btn_star"
                        app:startIconTint="@color/culinary_primary">

                        <AutoCompleteTextView
                            android:id="@+id/skillLevelAutoCompleteTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/culinary_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/yearsOfExperienceInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                        android:hint="Ani de experiență"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary"
                        app:startIconDrawable="@android:drawable/ic_menu_recent_history"
                        app:startIconTint="@color/culinary_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/yearsOfExperienceEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="2"
                            android:maxLines="1"
                            android:textColor="@color/culinary_text" />
                    </com.google.android.material.textfield.TextInputLayout>

            <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif"
                        android:text="Specializări culinare"
                        android:textAppearance="?attr/textAppearanceSubtitle1"
                        android:textColor="@color/culinary_secondary" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/specializariChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="4dp"
                        app:chipSpacingVertical="4dp"
                        android:clipToPadding="false"
                        android:layoutAnimation="@null"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/desertChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Preparate desert"
                            android:text="Desert"
                            app:chipBackgroundColor="@color/culinary_secondary_light"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_secondary"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/soupChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Preparate ciorbă și supă"
                            android:text="Ciorbă și supă"
                            app:chipBackgroundColor="@color/culinary_secondary_light"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_secondary"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mainCourseChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Fel principal"
                            android:text="Fel principal"
                            app:chipBackgroundColor="@color/culinary_secondary_light"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_secondary"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/grilledChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Preparate la grătar"
                            android:text="Grătar"
                            app:chipBackgroundColor="@color/culinary_secondary_light"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_secondary"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/bakingChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Produse de patiserie și brutărie"
                            android:text="Patiserie și brutărie"
                            app:chipBackgroundColor="@color/culinary_secondary_light"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_secondary"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/traditionalChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Bucătărie tradițională românească"
                            android:text="Bucătărie tradițională"
                            app:chipBackgroundColor="@color/culinary_secondary_light"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_secondary"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/addSpecializareChip"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Adaugă specializare nouă"
                            android:text="+ Adaugă"
                            app:chipBackgroundColor="@color/culinary_surface"
                            app:chipIcon="@android:drawable/ic_menu_add"
                            app:chipIconTint="@color/culinary_primary"
                            app:chipStrokeColor="@color/culinary_primary"
                            app:chipStrokeWidth="1dp" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dietary Preferences Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dietaryPreferencesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Preferințe alimentare"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/dietaryPreferencesChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="4dp"
                        android:clipToPadding="false"
                        android:layoutAnimation="@null"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/vegetarianChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Vegetarian"
                            android:text="Vegetarian"
                            app:chipBackgroundColor="@color/culinary_difficulty_easy"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_accent"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/veganChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Vegan"
                            android:text="Vegan"
                            app:chipBackgroundColor="@color/culinary_difficulty_easy"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_accent"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/glutenFreeChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Fără gluten"
                            android:text="Fără gluten"
                            app:chipBackgroundColor="@color/culinary_difficulty_easy"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_accent"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/lactoseFreeChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Fără lactoză"
                            android:text="Fără lactoză"
                            app:chipBackgroundColor="@color/culinary_difficulty_easy"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_accent"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/lowCarbChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Low carb"
                            android:text="Low carb"
                            app:chipBackgroundColor="@color/culinary_difficulty_easy"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_accent"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/ketoChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Keto"
                            android:text="Keto"
                            app:chipBackgroundColor="@color/culinary_difficulty_easy"
                            app:chipIconTint="@color/white"
                            app:chipStrokeColor="@color/culinary_accent"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/addDietaryPreferenceChip"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Adaugă preferință alimentară"
                            android:text="+ Adaugă"
                            app:chipBackgroundColor="@color/culinary_surface"
                            app:chipIcon="@android:drawable/ic_menu_add"
                            app:chipIconTint="@color/culinary_accent"
                            app:chipStrokeColor="@color/culinary_accent"
                            app:chipStrokeWidth="1dp" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Favorite Cuisines Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/favoriteCuisinesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

            <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Bucătării preferate"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/favoriteCuisineLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Adaugă bucătărie preferată"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:endIconDrawable="@android:drawable/ic_menu_add"
                        app:endIconMode="custom"
                        app:endIconTint="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary">

                        <AutoCompleteTextView
                            android:id="@+id/favoriteCuisineAutoCompleteTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/culinary_text" />
                    </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/favoriteCuisinesChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="4dp"
                        app:chipSpacingVertical="4dp"
                        android:clipToPadding="false"
                        android:layoutAnimation="@null"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/romanianCuisineChip"
                            style="@style/Widget.MaterialComponents.Chip.Entry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Bucătărie românească"
                            android:text="Românească"
                            app:chipBackgroundColor="@color/culinary_primary_light"
                            app:chipIconTint="@color/white"
                            app:closeIconTint="@color/white"
                            app:closeIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/italianCuisineChip"
                            style="@style/Widget.MaterialComponents.Chip.Entry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Bucătărie italiană"
                            android:text="Italiană"
                            app:chipBackgroundColor="@color/culinary_primary_light"
                            app:chipIconTint="@color/white"
                            app:closeIconTint="@color/white"
                            app:closeIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/frenchCuisineChip"
                            style="@style/Widget.MaterialComponents.Chip.Entry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Bucătărie franceză"
                            android:text="Franceză"
                            app:chipBackgroundColor="@color/culinary_primary_light"
                            app:chipIconTint="@color/white"
                            app:closeIconTint="@color/white"
                            app:closeIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/asianCuisineChip"
                            style="@style/Widget.MaterialComponents.Chip.Entry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Bucătărie asiatică"
                            android:text="Asiatică"
                            app:chipBackgroundColor="@color/culinary_primary_light"
                            app:chipIconTint="@color/white"
                            app:closeIconTint="@color/white"
                            app:closeIconVisible="true" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- About Me Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aboutMeCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Despre mine"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/aboutMeInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Descriere personală"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:counterEnabled="true"
                        app:counterMaxLength="500"
                        app:hintTextColor="@color/culinary_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/aboutMeEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:imeOptions="actionDone"
                            android:inputType="textMultiLine"
                            android:minLines="5"
                            android:textColor="@color/culinary_text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/exportProfileButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Exportă profil"
                    android:textColor="@color/culinary_primary"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="@color/culinary_primary"
                    app:strokeColor="@color/culinary_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveProfileButton"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:padding="12dp"
                    android:text="Salvează profil"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/culinary_primary"
                    app:elevation="4dp"
                    app:icon="@android:drawable/ic_menu_save"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout> 