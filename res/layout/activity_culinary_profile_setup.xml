<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/culinary_background"
    tools:context=".Joc1.Culinary.CulinaryProfileSetupActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/culinary_primary"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay" 
            app:title="Configurare profil culinar"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Profile Image Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profileImageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profileImageView"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:contentDescription="Fotografie de profil"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:civ_border_color="@color/culinary_primary"
                        app:civ_border_width="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uploadPhotoButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Încarcă fotografie"
                        android:textColor="@color/culinary_primary"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconTint="@color/culinary_primary"
                        app:strokeColor="@color/culinary_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Skill Level Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nivel de experiență"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/skillLevelDropdown"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Selectează nivelul"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary"
                        app:startIconDrawable="@android:drawable/btn_star"
                        app:startIconTint="@color/culinary_primary">

                        <AutoCompleteTextView
                            android:id="@+id/skillLevelAutoCompleteTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:contentDescription="Nivel de experiență în gătit" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dietary Preferences Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferințe dietetice"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selectați toate opțiunile care se aplică:"
                        android:textAppearance="?attr/textAppearanceBody2"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/dietaryPreferencesChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/dietNoneChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Fără restricții alimentare"
                            android:text="Fără restricții"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/dietVegetarianChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Vegetarian"
                            android:text="Vegetarian"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/dietVeganChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Vegan"
                            android:text="Vegan"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/dietGlutenFreeChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Fără gluten"
                            android:text="Fără gluten"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/dietLactoseFreeChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Fără lactoză"
                            android:text="Fără lactoză"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/dietKetoChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Keto"
                            android:text="Keto"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/dietLowCarbChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Low carb"
                            android:text="Low carb"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/addDietaryPreferenceChip"
                            style="@style/Widget.MaterialComponents.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Adaugă preferință alimentară"
                            android:text="+ Adaugă"
                            app:chipBackgroundColor="@color/culinary_surface"
                            app:chipIcon="@android:drawable/ic_menu_add"
                            app:chipIconTint="@color/culinary_primary"
                            app:chipStrokeColor="@color/culinary_primary"
                            app:chipStrokeWidth="1dp" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Allergies Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alergii alimentare"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/allergyInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Adaugă alergie"
                        android:layout_marginBottom="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:endIconDrawable="@android:drawable/ic_menu_add"
                        app:endIconMode="custom"
                        app:endIconTint="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/allergyInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/allergiesChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Meal Times Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mese preferate"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/mealTimesChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mealBreakfastChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Mic dejun"
                            android:text="Mic dejun"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mealLunchChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Prânz"
                            android:text="Prânz"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mealDinnerChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Cină"
                            android:text="Cină"
                            app:chipBackgroundColor="@color/culinary_chip_background" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/mealSnackChip"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:contentDescription="Gustare"
                            android:text="Gustare"
                            app:chipBackgroundColor="@color/culinary_chip_background" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cuisine Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/culinary_surface"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/culinary_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bucătării preferate"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textColor="@color/culinary_primary"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cuisineInputLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Adaugă bucătărie preferată"
                        android:layout_marginBottom="8dp"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/culinary_primary"
                        app:endIconDrawable="@android:drawable/ic_menu_add"
                        app:endIconMode="custom"
                        app:endIconTint="@color/culinary_primary"
                        app:hintTextColor="@color/culinary_primary">

                        <AutoCompleteTextView
                            android:id="@+id/cuisineAutoCompleteTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cuisineChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveProfileButton"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:text="Salvează profil"
                android:textColor="@color/white"
                app:backgroundTint="@color/culinary_primary"
                app:elevation="4dp"
                app:icon="@android:drawable/ic_menu_save"
                app:iconTint="@color/white" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
