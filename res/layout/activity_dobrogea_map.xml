<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dobrogea_map_background">

    <!-- Welcome Screen Elements -->
    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/start_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/welcome_text"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="@string/start_journey"/>

    <!-- Delta Dunării -->
    <ImageView
        android:id="@+id/delta_location"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="80dp"
        android:layout_marginTop="120dp"
        android:src="@drawable/ic_delta"
        android:contentDescription="@string/delta_location_desc"
        android:visibility="gone"/>

    <!-- Constanța - Cazinoul -->
    <ImageView
        android:id="@+id/constanta_location"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="150dp"
        android:layout_marginTop="180dp"
        android:src="@drawable/ic_casino"
        android:contentDescription="@string/casino_location_desc"
        android:visibility="gone"/>

    <!-- Cetatea Histria -->
    <ImageView
        android:id="@+id/histria_location"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="100dp"
        android:layout_marginTop="220dp"
        android:src="@drawable/ic_fortress"
        android:contentDescription="@string/histria_location_desc"
        android:visibility="gone"/>

    <!-- Moscheea Carol I -->
    <ImageView
        android:id="@+id/mosque_location"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="180dp"
        android:layout_marginTop="200dp"
        android:src="@drawable/ic_mosque"
        android:contentDescription="@string/mosque_location_desc"
        android:visibility="gone"/>

    <!-- Plajele Dobrogene -->
    <ImageView
        android:id="@+id/beach_location"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="120dp"
        android:layout_marginTop="250dp"
        android:src="@drawable/ic_beach"
        android:contentDescription="@string/beach_location_desc"
        android:visibility="gone"/>

</RelativeLayout>
