                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/descManastireaTreiIerarhi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Un monument deosebit prin arhitectura sa, cu fațade bogat ornamentate. Aici sunt înmormântați domnitori precum Alexandru Ioan Cuza și Dimitrie Cantemir."
                    android:textColor="#000000"
                    app:layout_constraintTop_toBottomOf="@id/titleManastireaTreiIerarhi" />

                <ImageView
                    android:id="@+id/imageManastireaTreiIerarhi"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#20000000"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toBottomOf="@id/descManastireaTreiIerarhi" />

                <com.google.android.material.textfield.TextInputLayout
