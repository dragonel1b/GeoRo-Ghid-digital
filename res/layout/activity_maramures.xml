<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/maramures_bg_simple">

    <!-- Header with back button -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@color/rom_region_maramures"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:onClick="goBack"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/regionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Maramureș"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.AppCompat.Title"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGoToCities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orașe"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:cornerRadius="20dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/white"
            app:backgroundTint="@color/rom_region_maramures"
            android:textColor="@color/white"
            app:rippleColor="@color/rom_primary_light"/>

        <TextView
            android:id="@+id/textBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:drawableStart="@drawable/ic_money"
            android:drawablePadding="4dp"
            android:drawableTint="@color/white"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"/>
    </LinearLayout>

    <!-- Image Carousel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/imageCarousel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/imageIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/imageCarousel"
        app:tabBackground="@drawable/tab_selector"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabTextColor="@color/rom_text"
        app:tabSelectedTextColor="@color/rom_region_maramures"
        android:background="@color/white"/>

    <!-- Content Sections -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/imageIndicator"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Introduction Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bine ai venit în Maramureș"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/rom_region_maramures"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Descoperă meleagurile maramureșene, o regiune cu tradiții vii, peisaje montane spectaculoase și arhitectura tradițională din lemn. Cunoscută drept 'țara lemnului', Maramureșul te așteaptă să-i descoperi frumusețile."
                        android:textColor="@color/rom_text"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- City Cards Container -->
            <LinearLayout
                android:id="@+id/cityContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- City Card: Baia Mare -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/rom_region_maramures">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:onClick="showPopup1">
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- City Card: Sighetu Marmației -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/rom_region_maramures">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:onClick="showPopup2">
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Navigation Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToMap"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Harta Maramureșului"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_map"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/rom_region_maramures"
                app:rippleColor="@color/rom_primary_light"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp"
                android:elevation="8dp"
                android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToMaramuresGame"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Aventura Maramureșului"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_quiz"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/rom_quiz_color"
                app:rippleColor="@color/rom_region_maramures"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp"
                android:elevation="8dp"
                android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToMaramuresStory"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Povestea Maramureșului"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_story"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="@color/white"
                app:backgroundTint="@color/rom_churches_color"
                app:rippleColor="@color/rom_primary_light"
                app:strokeColor="@color/white"
                app:strokeWidth="1dp"
                android:elevation="8dp"
                android:textColor="@color/white"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView
        android:id="@+id/confetti_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/confetti_animation"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
