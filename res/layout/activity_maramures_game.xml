<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/maramures_header">

    <!-- Header with Timer and Score -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@color/maramures_primary"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/white"/>

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/timer_background_maramures">

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="20"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>
        </FrameLayout>

        <TextView
            android:id="@+id/gameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Aventura Maramureșului"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scor: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/maramures_accent"/>
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:progressTint="@color/maramures_accent"
        android:progressBackgroundTint="@color/maramures_secondary"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <!-- Lifelines -->
    <LinearLayout
        android:id="@+id/lifelinesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/maramures_secondary"
        app:layout_constraintTop_toBottomOf="@id/progress_bar">

        <ImageButton
            android:id="@+id/btn_fifty_fifty"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:src="@drawable/ic_5050"
            android:tint="@color/white"
            android:background="@drawable/timer_background_maramures"
            android:contentDescription="50:50"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Descoperă tainele Maramureșului"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <ImageButton
            android:id="@+id/btn_skip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:src="@drawable/ic_skip"
            android:tint="@color/white"
            android:background="@drawable/timer_background_maramures"
            android:contentDescription="Skip Question"/>
    </LinearLayout>

    <!-- Question Card with Image -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/questionCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/maramures_accent"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/lifelinesLayout"
        app:layout_constraintBottom_toTopOf="@id/answersContainer"
        app:layout_constraintVertical_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_question_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:contentDescription="Question Image"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:textColor="@color/maramures_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_fact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_gradient_background_maramures"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_gravity="center"
                android:background="@drawable/timer_background_maramures"
                android:elevation="4dp"
                android:padding="8dp"
                android:text="🔥 Reușite consecutive: 0"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" 
                android:visibility="gone"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Answer Buttons -->
    <LinearLayout
        android:id="@+id/answersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btn_finish"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            style="@style/AnswerButtonStyle"
            android:id="@+id/btn_answer1"
            tools:text="Answer 1" />

        <com.google.android.material.button.MaterialButton
            style="@style/AnswerButtonStyle"
            android:id="@+id/btn_answer2"
            tools:text="Answer 2" />

        <com.google.android.material.button.MaterialButton
            style="@style/AnswerButtonStyle"
            android:id="@+id/btn_answer3"
            tools:text="Answer 3" />

        <com.google.android.material.button.MaterialButton
            style="@style/AnswerButtonStyle"
            android:id="@+id/btn_answer4"
            tools:text="Answer 4" />
    </LinearLayout>

    <!-- Finish Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_finish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:text="Finalizează Quiz"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/maramures_accent"
        app:strokeWidth="1dp"
        app:strokeColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout> 