<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    tools:context=".Joc1.Culinary.MealPlannerActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Planificator de mese"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:navigationIconTint="?attr/colorOnSurface"
            app:menu="@menu/menu_meal_planner"
            android:contentDescription="Bară de navigare pentru planificatorul de mese"/>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:scrollbarStyle="outsideOverlay"
        android:fadeScrollbars="false"
        android:paddingBottom="88dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Weekly Meal Planning Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/weeklyPlanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                android:focusable="true"
                android:clickable="true"
                app:rippleColor="?attr/colorPrimaryVariant"
                android:contentDescription="Planificarea săptămânii">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weeklyPlanTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Planificarea săptămânii"
                            android:contentDescription="Secțiune pentru planificarea săptămânală a meselor"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
                            android:textColor="?attr/colorOnSurface"/>

                        <ImageButton
                            android:id="@+id/editWeeklyPlanButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Editează planul săptămânal"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="?attr/colorPrimary"/>
                    </LinearLayout>

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/weekDaysTabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:tabMode="scrollable"
                        app:tabGravity="start"
                        app:tabIndicatorColor="?attr/colorPrimary"
                        app:tabSelectedTextColor="?attr/colorPrimary"
                        app:tabTextColor="?attr/colorOnSurfaceVariant"
                        app:tabContentStart="8dp"
                        app:tabPaddingStart="12dp"
                        app:tabPaddingEnd="12dp"
                        android:contentDescription="Zile ale săptămânii"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/weeklyPlanRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:contentDescription="Listă cu mesele planificate pentru ziua selectată"
                        android:nestedScrollingEnabled="false"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_meal_plan"/>

                    <TextView
                        android:id="@+id/emptyPlanMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="32dp"
                        android:gravity="center"
                        android:text="Nu există mese planificate pentru această zi"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Meal Suggestions Section (Carousel) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/suggestionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                android:focusable="true"
                android:clickable="true"
                app:rippleColor="?attr/colorPrimaryVariant"
                android:contentDescription="Sugestii pentru mese">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/suggestionsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sugestii pentru mese"
                        android:contentDescription="Secțiune cu sugestii personalizate de mese"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
                        android:textColor="?attr/colorOnSurface"/>

                    <TextView
                        android:id="@+id/suggestionsDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pe baza preferințelor și istoricului dvs."
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                        android:textColor="?attr/colorOnSurfaceVariant"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <!-- Material 3-like Carousel implementation -->
                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/suggestionsCarousel"
                            android:layout_width="match_parent"
                            android:layout_height="250dp"
                            android:contentDescription="Carusel cu sugestii de mese"
                            android:clipToPadding="false"
                            android:clipChildren="false"
                            android:paddingStart="40dp"
                            android:paddingEnd="40dp"
                            android:importantForAccessibility="yes"/>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/suggestionsLoadingIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/carouselIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="8dp"
                        android:background="@android:color/transparent"
                        app:tabBackground="@drawable/tab_selector"
                        app:tabGravity="center"
                        app:tabIndicatorHeight="0dp"
                        app:tabMinWidth="10dp"
                        app:tabMaxWidth="10dp"
                        android:contentDescription="Indicatori pagini carusel"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nutritional Statistics Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nutritionStatsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                android:focusable="true"
                android:clickable="true"
                app:rippleColor="?attr/colorPrimaryVariant"
                android:contentDescription="Statistici nutriționale">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/nutritionStatsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Statistici nutriționale"
                        android:contentDescription="Secțiune cu analize nutriționale"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
                        android:textColor="?attr/colorOnSurface"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:scrollbars="none"
                        android:fadeScrollbars="false">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/nutritionStatsChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:chipSpacing="8dp"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/caloriesChip"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:contentDescription="Afișează statistici despre calorii"
                                android:text="Calorii"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/proteinsChip"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Afișează statistici despre proteine"
                                android:text="Proteine"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/carbsChip"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Afișează statistici despre carbohidrați"
                                android:text="Carbohidrați"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/fatsChip"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Afișează statistici despre grăsimi"
                                android:text="Grăsimi"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/vitaminsChip"
                                style="@style/Widget.MaterialComponents.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Afișează statistici despre vitamine"
                                android:text="Vitamine"/>
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <FrameLayout
                        android:id="@+id/nutritionStatsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="16dp">

                        <!-- MPAndroidChart implementation with animation and tooltip support -->
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/nutritionChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Grafic cu evoluția nutrienților în timp"/>

                        <TextView
                            android:id="@+id/noStatsMessage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="Nu există date suficiente pentru a afișa statistici"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/nutritionTip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawablePadding="8dp"
                        android:text="Sfat: Consumul recomandat de proteine pentru un adult este de 0.8g per kg de greutate corporală."
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="italic"
                        app:drawableStartCompat="@android:drawable/ic_menu_info_details"
                        app:drawableTint="?attr/colorPrimary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ExtendedFloatingActionButton with HideBottomViewOnScrollBehavior -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddMeal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Adaugă o masă nouă în plan"
        android:text="Adaugă masă"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="?attr/colorOnPrimary"
        app:iconGravity="textStart"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="6dp"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
