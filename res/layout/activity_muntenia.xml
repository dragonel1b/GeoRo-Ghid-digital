<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Header with back button -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#388E3C"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:onClick="goBack"
            android:tint="#FFFFFF"/>

        <TextView
            android:id="@+id/regionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Muntenia"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAppearance="@style/TextAppearance.AppCompat.Title"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonGoToCities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orașe"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:cornerRadius="20dp"
            app:strokeWidth="2dp"
            app:strokeColor="#C8E6C9"
            app:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            app:rippleColor="#A5D6A7"/>

        <TextView
            android:id="@+id/pointsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:drawableStart="@drawable/ic_money"
            android:drawablePadding="4dp"
            android:drawableTint="#FFEB3B"
            android:textAppearance="@style/TextAppearance.AppCompat.Body1"/>
    </LinearLayout>

    <!-- Image Carousel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/imageCarousel"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"/>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/imageIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/imageCarousel"
        app:tabBackground="@drawable/tab_selector"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabTextColor="#FFFFFF"
        app:tabSelectedTextColor="#C8E6C9"
        android:background="#388E3C"/>

    <!-- Content Sections -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/imageIndicator"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Introduction Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#E8F5E9">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bine ai venit în Muntenia"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"/>
                        
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Descoperă frumusețile Munteniei, o regiune istorică din sudul României, cu câmpii fertile, orașe vibrante și monumente istorice impresionante. Țara Românească te așteaptă să îi descoperi bogăția culturală și patrimoniul unic."
                        android:textColor="#1B5E20"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/cityContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">
                <!-- Content will be added dynamically -->
            </LinearLayout>

            <!-- Navigation Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToMap"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Harta Interactivă"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_map"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#4CAF50"
                app:rippleColor="#A5D6A7"
                android:elevation="8dp"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToCasinoStory"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Muntenia Story"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_story"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#388E3C"
                app:rippleColor="#A5D6A7"
                android:elevation="8dp"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonGoToDobrogeaGame"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Muntenia Quest"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_game"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="24dp"
                app:iconTint="#FFFFFF"
                app:backgroundTint="#66BB6A"
                app:rippleColor="#388E3C"
                android:elevation="8dp"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
