<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/rom_background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="100dp"
        android:paddingTop="16dp"
        android:paddingHorizontal="16dp">

        <!-- Header Container -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/quizTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quiz Cultural"
                style="@style/RomTextTitle"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scor: 0"
                style="@style/RomTextSubtitle"
                android:textColor="@color/rom_culture_points_color"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- Quiz Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/quizCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/RomCardView"
            app:layout_constraintTop_toBottomOf="@id/headerContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Question -->
                <TextView
                    android:id="@+id/questionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/RomTextSubtitle"
                    android:layout_marginBottom="16dp" />

                <!-- Answer Options -->
                <RadioGroup
                    android:id="@+id/answersGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/RomProgressBar"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:progress="33"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/quizCard" />

        <!-- Quiz Rules Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rulesCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            style="@style/RomCardView"
            app:layout_constraintTop_toBottomOf="@id/progressBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reguli Quiz:"
                    style="@style/RomTextSubtitle"
                    android:textColor="@color/rom_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="• Fiecare răspuns corect = 10 puncte"
                    style="@style/RomTextBody" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Nu poți schimba răspunsul după verificare"
                    style="@style/RomTextBody" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Punctele se transformă în puncte culturale la final"
                    style="@style/RomTextBody" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/rulesCard">

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="Verifică Răspunsul"
                style="@style/RomButton"
                android:textSize="16sp" />

            <!-- Next Button (Initially Hidden) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Următoarea Întrebare"
                style="@style/RomButton"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Back Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:onClick="goBack"
            android:src="@drawable/ic_back"
            style="@style/RomMapMarker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
