<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rom_background_light"
    tools:context=".Joc1.RomMapActivity">

    <!-- Map container - always at the bottom layer -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.gms.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/rom_map_description" />
    </FrameLayout>

    <!-- Top controls bar with search and navigation -->
    <LinearLayout
        android:id="@+id/topControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <!-- Search and back button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Back button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                android:layout_marginEnd="8dp">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Înapoi"
                    android:src="@drawable/ic_back"
                    android:padding="12dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar with background -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:color/white"
                    app:iconifiedByDefault="false"
                    app:queryHint="Caută în România" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Region selection with proper background -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/regionsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Status card with player info (always visible) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerStatusCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:layout_anchor="@id/mapContainer"
        app:layout_anchorGravity="top|end">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Chapter info -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chapter"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/chapterText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Capitol 1"
                    android:layout_marginStart="4dp"
                    android:textStyle="bold"
                    android:textColor="@color/rom_text_primary"/>
            </LinearLayout>

            <!-- Wisdom points -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_wisdom"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/wisdomPointsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_marginStart="4dp"
                    android:textStyle="bold"
                    android:textColor="@color/rom_text_primary"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Discover FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/discoverFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/rom_discover_button"
        android:text="Descoperă"
        app:icon="@drawable/ic_discovery" />

    <!-- Region Info Card Bottom Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/regionInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/regionNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transilvania"
                android:textColor="@color/rom_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/regionDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Descoperă frumusețea și diversitatea Transilvaniei, o regiune cu o bogată istorie și tradiții."
                android:textColor="@color/rom_text_secondary"
                android:textSize="16sp" />

            <!-- Region missions preview -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Misiuni disponibile"
                android:textStyle="bold"
                android:textColor="@color/rom_text_primary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/regionMissionsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:maxHeight="200dp"
                android:nestedScrollingEnabled="true"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exploreButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Explorează regiunea"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="end" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Story card dialog -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/storyCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_anchor="@id/mapContainer"
        app:layout_anchorGravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/storyTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Capitol: Începutul Călătoriei"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/rom_text_primary"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/storyDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Călătoria ta prin România începe aici. Explorează, descoperă și învață despre minunile acestei țări."
                android:textColor="@color/rom_text_secondary"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="2dp"
                    android:layout_marginEnd="16dp">
                    
                    <ImageView
                        android:id="@+id/characterImageView"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_character_guide"
                        android:contentDescription="Personaj"/>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/characterNameText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dragomir"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/rom_text_primary"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/characterDialogText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bine ai venit în călătoria noastră prin România! Sunt Dragomir și te voi ghida prin această aventură."
                        android:textStyle="italic"
                        android:textColor="@color/rom_text_secondary"
                        android:textSize="15sp"/>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continuă"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="end"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Missions panel that slides in from the side -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/missionsPanelCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="64dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Misiunile Tale"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/rom_text_primary"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/missionsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingBottom="8dp"
                android:clipToPadding="false"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeMissionsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Închide"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Show missions FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/showMissionsFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:contentDescription="Arată misiunile"
        android:src="@drawable/ic_quest"/>

    <!-- Quest RecyclerView for Bottom Sheet -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/questRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />
</androidx.coordinatorlayout.widget.CoordinatorLayout> 