<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".RomApp.Soroca">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Înapoi"
            android:layout_marginBottom="16dp"
            android:onClick="goBack" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Soroca"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Cetatea Soroca -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardCetateaSoroca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_gradient_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/titleCetateaSoroca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cetatea Soroca"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/imageCetateaSoroca"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_add_photo"
                android:background="#EFEFEF"
                app:layout_constraintTop_toBottomOf="@id/titleCetateaSoroca" />

            <ImageView
                android:id="@+id/checkCetateaSoroca"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_check"
                android:visibility="invisible"
                app:layout_constraintTop_toTopOf="@id/imageCetateaSoroca"
                app:layout_constraintEnd_toEndOf="@id/imageCetateaSoroca"
                android:layout_margin="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutNoteCetateaSoroca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Părerea ta"
                app:layout_constraintTop_toBottomOf="@id/imageCetateaSoroca">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/noteCetateaSoroca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRecommendationCetateaSoroca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Recomandări"
                app:layout_constraintTop_toBottomOf="@id/layoutNoteCetateaSoroca">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recommendationCetateaSoroca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Muzeul Etnografic -->
