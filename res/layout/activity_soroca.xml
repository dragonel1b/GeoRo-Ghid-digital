                app:layout_constraintTop_toBottomOf="@id/imageMuzeulEtnografic">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/noteMuzeulEtnografic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRecommendationMuzeulEtnografic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Recomandări"
                app:layout_constraintTop_toBottomOf="@id/layoutNoteMuzeulEtnografic">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recommendationMuzeulEtnografic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Complexul Memorial -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardComplexulMemorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_gradient_background"
