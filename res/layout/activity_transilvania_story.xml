<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B1B17"
    tools:context=".transilvaniausage.DraculaStoryActivity">

    <!-- Header with back button and sound toggle -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#461B0E"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/headerBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Transilvania"
            android:textColor="#E8C9AF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/soundToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:padding="8dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_sound_on"
            android:contentDescription="Toggle sound" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Progress Indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        android:progress="0"
        app:indicatorColor="#800000"
        app:trackColor="#4D1919" />

    <!-- Bottom Button Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#461B0E"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/storyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Citește povestea"
            android:textColor="#FFFFFF"
            app:backgroundTint="#800000"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nextButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Continuă"
            android:textColor="#FFFFFF"
            app:backgroundTint="#800000"
            app:layout_constraintStart_toEndOf="@id/storyButton"
            app:layout_constraintEnd_toStartOf="@id/exitButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Continuă"
            android:textColor="#FFFFFF"
            app:backgroundTint="#800000"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/storyButton"
            app:layout_constraintEnd_toStartOf="@id/exitButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
            
        <com.google.android.material.button.MaterialButton
            android:id="@+id/finishButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Finalizează Aventura"
            android:textColor="#FFFFFF"
            app:backgroundTint="#4D1919"
            android:visibility="gone"
            app:icon="@drawable/ic_exit"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/exitButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exitButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X"
            android:textColor="#FFFFFF"
            app:backgroundTint="#4D1919"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/nextButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main content scrollable area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/progressIndicator"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Story Title -->
            <TextView
                android:id="@+id/storyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#E8C9AF"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Bine ai venit în Transilvania!" />

            <!-- Main Story Image -->
            <ImageView
                android:id="@+id/storyImageView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                app:layout_constraintTop_toBottomOf="@id/storyTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:contentDescription="Story image"
                tools:src="@drawable/castle_dracula" />

            <!-- Bat Animation Image (initially invisible) -->
            <ImageView
                android:id="@+id/batAnimation"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@id/storyImageView"
                app:layout_constraintBottom_toBottomOf="@id/storyImageView"
                app:layout_constraintStart_toStartOf="@id/storyImageView"
                app:layout_constraintEnd_toEndOf="@id/storyImageView"
                android:contentDescription="Bat animation" />

            <!-- Story Text -->
            <TextView
                android:id="@+id/storyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="16sp"
                android:textColor="#E8C9AF"
                android:lineSpacingExtra="4dp"
                app:layout_constraintTop_toBottomOf="@id/storyImageView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Transilvania, ținutul misterios din inima României, înconjurat de munți maiestuoși și păduri întunecate..." />

            <!-- Story Context -->
            <TextView
                android:id="@+id/storyContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="14sp"
                android:textColor="#A58D7F"
                android:textStyle="italic"
                app:layout_constraintTop_toBottomOf="@id/storyText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Transilvania este cunoscută în întreaga lume datorită legendei lui Dracula..." />

            <!-- Feedback Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/feedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#461B0E"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/storyContext"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/feedbackText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="#E8C9AF"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    tools:text="Ai primit 50 de puncte!" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Betting Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/bettingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#461B0E"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/feedbackCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/betInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Introdu suma"
                        android:textColorHint="#A58D7F"
                        app:boxBackgroundColor="#2B1B17"
                        app:boxStrokeColor="#800000"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/betAmountInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="#E8C9AF" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/redButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Roșu"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#800000"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toBottomOf="@id/betInputLayout"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/blackButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/blackButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Negru"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#000000"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toBottomOf="@id/betInputLayout"
                        app:layout_constraintStart_toEndOf="@id/redButton"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Interactive Card for Vampire Test -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/interactiveCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#461B0E"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/bettingCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/vampireTestTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Testul Vampirului"
                        android:textColor="#E8C9AF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/vampireTestDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Alege obiectul care te atrage cel mai mult:"
                        android:textColor="#A58D7F"
                        android:textAlignment="center"
                        app:layout_constraintTop_toBottomOf="@id/vampireTestTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/objectCard1"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:cardBackgroundColor="#2B1B17"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp"
                        app:strokeColor="#800000"
                        app:strokeWidth="1dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/vampireTestDesc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/objectCard2">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/bloodIcon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_blood"
                                app:tint="#800000"
                                android:contentDescription="Blood"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toTopOf="@id/bloodText"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintVertical_chainStyle="packed" />

                            <TextView
                                android:id="@+id/bloodText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sânge"
                                android:textColor="#E8C9AF"
                                android:layout_marginTop="8dp"
                                app:layout_constraintTop_toBottomOf="@id/bloodIcon"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/objectCard2"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:cardBackgroundColor="#2B1B17"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp"
                        app:strokeColor="#A58D7F"
                        app:strokeWidth="1dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/vampireTestDesc"
                        app:layout_constraintStart_toEndOf="@id/objectCard1"
                        app:layout_constraintEnd_toStartOf="@id/objectCard3">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/crucifixIcon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_crucifix"
                                app:tint="#E8C9AF"
                                android:contentDescription="Crucifix"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toTopOf="@id/crucifixText"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintVertical_chainStyle="packed" />

                            <TextView
                                android:id="@+id/crucifixText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Crucifix"
                                android:textColor="#E8C9AF"
                                android:layout_marginTop="8dp"
                                app:layout_constraintTop_toBottomOf="@id/crucifixIcon"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/objectCard3"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        app:cardBackgroundColor="#2B1B17"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="2dp"
                        android:layout_margin="4dp"
                        app:strokeColor="#A58D7F"
                        app:strokeWidth="1dp"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/vampireTestDesc"
                        app:layout_constraintStart_toEndOf="@id/objectCard2"
                        app:layout_constraintEnd_toEndOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/moonIcon"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:src="@drawable/ic_moon"
                                app:tint="#E8C9AF"
                                android:contentDescription="Moon"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toTopOf="@id/moonText"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintVertical_chainStyle="packed" />

                            <TextView
                                android:id="@+id/moonText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Luna"
                                android:textColor="#E8C9AF"
                                android:layout_marginTop="8dp"
                                app:layout_constraintTop_toBottomOf="@id/moonIcon"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Options Container for Choice Buttons - Using ConstraintLayout -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/interactiveCardView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout> 