<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/cityNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cluj-Napoca"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/city_name_text"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/regionNameText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transilvania"
        android:textSize="16sp"
        android:textColor="@color/rom_text_secondary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/cityDescriptionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Un important centru cultural, educațional și economic din Transilvania. Este cunoscut pentru universitățile sale și vibranta scenă artistică."
        android:textSize="15sp"
        android:textColor="@color/city_desc_text"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/cityImageView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_explore"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

</LinearLayout> 