<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    android:clickable="true"
    android:focusable="true"
    android:checkable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Difficulty indicator (vertical bar) -->
        <View
            android:id="@+id/difficultyIndicator"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@color/difficulty_medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Recipe Name -->
        <TextView
            android:id="@+id/nameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/difficultyIndicator"
            app:layout_constraintEnd_toStartOf="@id/timeTextView"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sarmale Moldovenești" />

        <!-- Cooking Time -->
        <TextView
            android:id="@+id/timeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:drawableStart="@drawable/ic_time"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/nameTextView"
            app:layout_constraintBottom_toBottomOf="@id/nameTextView"
            tools:text="120 min" />

        <!-- Region -->
        <com.google.android.material.chip.Chip
            android:id="@+id/regionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Widget.Material3.Chip.Assist"
            app:chipBackgroundColor="?attr/colorSecondaryContainer"
            android:textColor="?attr/colorOnSecondaryContainer"
            app:chipMinHeight="24dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            app:layout_constraintStart_toStartOf="@id/nameTextView"
            app:layout_constraintTop_toBottomOf="@id/nameTextView"
            tools:text="Moldova" />

        <!-- Category -->
        <com.google.android.material.chip.Chip
            android:id="@+id/categoryTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            style="@style/Widget.Material3.Chip.Assist"
            app:chipBackgroundColor="?attr/colorTertiaryContainer"
            android:textColor="?attr/colorOnTertiaryContainer"
            app:chipMinHeight="24dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            app:layout_constraintStart_toEndOf="@id/regionTextView"
            app:layout_constraintTop_toTopOf="@id/regionTextView"
            app:layout_constraintBottom_toBottomOf="@id/regionTextView"
            tools:text="Felul principal" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView> 