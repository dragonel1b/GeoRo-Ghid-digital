<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="0dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    android:clickable="true"
    android:focusable="true"
    android:checkable="true"
    style="?attr/materialCardViewFilledStyle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        
        <!-- Recipe Title -->
        <TextView
            android:id="@+id/recipeTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toStartOf="@id/mealTimeBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sarmale cu mămăligă" />
        
        <!-- Meal Time Badge - Icon showing recipe is recommended for current time -->
        <ImageView
            android:id="@+id/mealTimeBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_clock"
            app:tint="?attr/colorPrimary"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/recipeTitleText"
            app:layout_constraintBottom_toBottomOf="@id/recipeTitleText" />

        <!-- Recipe tags row -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/recipeTagsChipGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recipeTitleText">

            <!-- Region chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/recipeRegionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipMinHeight="32dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                app:chipBackgroundColor="?attr/colorSecondaryContainer"
                android:textColor="?attr/colorOnSecondaryContainer"
                style="@style/Widget.Material3.Chip.Assist"
                tools:text="Moldova" />

            <!-- Difficulty Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/difficultyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipMinHeight="32dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                app:chipBackgroundColor="?attr/colorTertiaryContainer"
                android:textColor="?attr/colorOnTertiaryContainer"
                style="@style/Widget.Material3.Chip.Assist"
                tools:text="Mediu" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Match percentage with linear progress indicator -->
        <TextView
            android:id="@+id/matchPercentageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Potrivire ingrediente:"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/recipeTagsChipGroup" />

        <TextView
            android:id="@+id/matchPercentageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintStart_toEndOf="@id/matchPercentageLabel"
            app:layout_constraintTop_toTopOf="@id/matchPercentageLabel"
            app:layout_constraintBottom_toBottomOf="@id/matchPercentageLabel"
            tools:text="75%" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/matchProgressIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:progress="75"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/matchPercentageLabel" />

        <!-- Missing ingredients with icon -->
        <ImageView
            android:id="@+id/missingIngredientsIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_shopping_basket"
            app:tint="?attr/colorOutline"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/matchProgressIndicator" />
            
        <TextView
            android:id="@+id/missingIngredientsText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/missingIngredientsIcon"
            app:layout_constraintTop_toTopOf="@id/missingIngredientsIcon"
            app:layout_constraintBottom_toBottomOf="@id/missingIngredientsIcon"
            tools:text="Îți lipsesc 2 ingrediente: smântână, pătrunjel" />

        <!-- Skill compatibility with icon -->
        <ImageView
            android:id="@+id/skillIcon"
            android:layout_width="24dp" 
            android:layout_height="24dp"
            android:src="@drawable/ic_skill_level"
            app:tint="?attr/colorOutline"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/missingIngredientsText" />
            
        <TextView
            android:id="@+id/skillCompatibilityText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="italic"
            app:layout_constraintStart_toEndOf="@id/skillIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/skillIcon"
            app:layout_constraintBottom_toBottomOf="@id/skillIcon"
            tools:text="Perfect pentru nivelul tău" />
            
        <!-- Meal type with icon -->
        <ImageView
            android:id="@+id/mealTypeIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_restaurant"
            app:tint="?attr/colorOutline"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skillCompatibilityText" />
            
        <TextView
            android:id="@+id/mealTypeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="italic"
            app:layout_constraintStart_toEndOf="@id/mealTypeIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mealTypeIcon"
            app:layout_constraintBottom_toBottomOf="@id/mealTypeIcon"
            tools:text="Ideal pentru cină" />

        <!-- Action buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewRecipeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vezi rețeta"
            android:layout_marginTop="16dp"
            style="@style/Widget.Material3.Button.TextButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mealTypeLabel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addToShoppingListButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adaugă la listă"
            android:layout_marginEnd="8dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:layout_constraintEnd_toStartOf="@id/viewRecipeButton"
            app:layout_constraintTop_toTopOf="@id/viewRecipeButton" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView> 