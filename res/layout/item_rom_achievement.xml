<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    style="@style/RomAchievementCard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with Icon and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/achievementIcon"
                style="@style/RomAchievementIcon"
                android:src="@drawable/ic_achievement"
                android:contentDescription="@string/rom_achievements_title"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <ImageView
                android:id="@+id/achievementStatus"
                style="@style/RomAchievementStatus"
                android:src="@drawable/ic_lock"
                android:contentDescription="@string/rom_achievements_unlocked_label"/>
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/achievementTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/RomTextSubtitle"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- Description -->
        <TextView
            android:id="@+id/achievementDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/RomTextBody"
            android:maxLines="3"
            android:ellipsize="end"/>

        <!-- Points Required -->
        <TextView
            android:id="@+id/achievementPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/RomTextCaption"
            android:textColor="@color/rom_culture_points_color"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
