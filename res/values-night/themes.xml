<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Dark theme colors -->
        <item name="colorPrimary">@color/rom_flag_blue_dark</item>
        <item name="colorPrimaryVariant">@color/rom_primary_dark</item>
        <item name="colorSecondary">@color/rom_flag_yellow_dark</item>
        <item name="colorSecondaryVariant">@color/rom_flag_red_dark</item>
        
        <!-- Dark background -->
        <item name="android:windowBackground">@color/dark_background_start</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/rom_flag_blue_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/rom_flag_blue_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Maintain other theme attributes -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="textInputStyle">@style/RomanianInputLayout</item>
        <item name="materialButtonStyle">@style/RomanianButton</item>
    </style>
</resources>
