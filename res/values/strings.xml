        <!-- Region Descriptions -->
        <string name="region_banat_desc">Regiunea istorică Banat, cunoscută pentru multiculturalismul său și arhitectura specifică.</string>
        <string name="region_crisana_desc">Crișana, o regiune cu tradiții bogate și peisaje pitorești.</string>
        <string name="region_maramures_desc">Maramureșul istoric, faimos pentru porțile sale sculptate și bisericile din lemn.</string>
        <string name="region_bucovina_desc">Bucovina, tărâmul mănăstirilor pictate și al tradițiilor păstrate.</string>
        <string name="region_transilvania_desc">Transilvania, inima României, cu cetăți medievale și diversitate culturală.</string>
        <string name="region_moldova_desc">Moldova, regiune cu mănăstiri istorice și tradiții viticole.</string>
        <string name="region_oltenia_desc">Oltenia, cunoscută pentru artă populară și arhitectură tradițională.</string>
        <string name="region_muntenia_desc">Muntenia, regiune cu contrast între modernitate și tradiție.</string>
        <string name="region_dobrogea_desc">Dobrogea, unde Dunărea întâlnește Marea Neagră.</string>

