    <!-- Tutorial -->
    <string name="tutorial_title">Cum se joacă</string>
    <string name="tutorial_step1">1. Jucătorii se împart în 2 echipe.</string>
    <string name="tutorial_step2">2. Echipele se așează față în față, în linie.</string>
    <string name="tutorial_step3">3. O echipă strigă: \"Țară, țară, vrem ostași!\"</string>
    <string name="tutorial_step4">4. Cealaltă echipă răspunde: \"Pe cine?\"</string>
    <string name="tutorial_step5">5. Prima echipă alege un jucător advers.</string>
    <string name="tutorial_step6">6. Jucătorul ales trebuie să spargă formația adversă.</string>
    <string name="tutorial_step7">7. Dacă reușește, se întoarce cu un prizonier.</string>
    <string name="tutorial_step8">8. Dacă nu reușește, rămâne în echipa adversă.</string>
    <string name="tutorial_step9">9. Câștigă echipa care capturează toți jucătorii.</string>
