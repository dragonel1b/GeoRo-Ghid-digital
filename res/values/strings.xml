        <!-- NPC Dialogues - Cluj -->
        <string-array name="npc_cluj_dialogues">
            <item>Bine ai venit în Cluj, inima Transilvaniei!</item>
            <item>Ai gustat vreodată varza à la Cluj? E o delicatesă locală!</item>
            <item>Știai că Universitatea Babeș-Bolyai este cea mai veche din România?</item>
            <item>Piața Unirii este locul perfect pentru a începe explorarea orașului.</item>
        </string-array>

        <!-- NPC Dialogues - Iași -->
        <string-array name="npc_iasi_dialogues">
            <item>Bine ai venit în Iași, capitala culturală a Moldovei!</item>
            <item>Palatul Culturii este simbolul orașului nostru.</item>
            <item>Grădina Copou ascunde multe povești fascinante.</item>
            <item>Ai văzut Teiul lui Eminescu? E un loc special pentru noi.</item>
        </string-array>

        <!-- NPC Dialogues - Timișoara -->
        <string-array name="npc_timisoara_dialogues">
            <item>Bun venit în Timișoara, primul oraș cu iluminat stradal electric din Europa!</item>
            <item>Piața Victoriei, sau Piața Operei cum îi spunem noi, e inima orașului.</item>
            <item>Timișoara e orașul florilor și al parcurilor.</item>
            <item>Revoluția din 1989 a început aici, în Piața Maria.</item>
        </string-array>

