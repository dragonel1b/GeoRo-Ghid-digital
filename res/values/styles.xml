    <!-- Region Colors -->
    <style name="RegionColorScheme">
        <item name="colorTransilvania">#3F51B5</item>
        <item name="colorMoldova">#4CAF50</item>
        <item name="colorMuntenia">#FF5722</item>
        <item name="colorDobrogea">#03A9F4</item>
        <item name="colorOltenia">#FFC107</item>
        <item name="colorBanat">#9C27B0</item>
        <item name="colorCrisana">#795548</item>
        <item name="colorMaramures">#009688</item>
